{
  "name": "@orkide/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./shadcn/*": "./src/shadcn/*.tsx",
    "./tokens/*": "./src/tokens/*.ts",
    "./motion/*": "./src/motion/*.ts",
    "./effects/*": "./src/effects/*.ts",
    "./kit/*": "./src/kit/*.tsx"
  },
  "scripts": {
    "tokens": "node scripts/tokens.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "shadcn": "catalog:",
    "sonner": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@orkide/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
