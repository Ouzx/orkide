{
  "$description": "Orkide skin tokens (W3C Design Tokens format). `$value` is the light theme; `$extensions.dark` is the dark theme. `pnpm --filter @orkide/ui tokens` builds src/styles/tokens.css and src/tokens/tokens.ts from this file.",
  "color": {
    "$type": "color",
    "case": {
      "$value": "#E7E3D9",
      "$extensions": {
        "dark": "#26272A"
      },
      "$description": "Page and device enclosure. The body background."
    },
    "panel": {
      "$value": "#DCD7CB",
      "$extensions": {
        "dark": "#1F2023"
      },
      "$description": "Raised panel: spec boxes, the admin bay, the back panel."
    },
    "deep": {
      "$value": "#CCC6B8",
      "$extensions": {
        "dark": "#17181A"
      },
      "$description": "Recesses: field wells, switch slots, unlit LEDs, keycap sides."
    },
    "ink": {
      "$value": "#1D1D1B",
      "$extensions": {
        "dark": "#ECE8DE"
      },
      "$description": "Primary text and rules."
    },
    "ink-2": {
      "$value": "#5B574F",
      "$extensions": {
        "dark": "#A6A298"
      },
      "$description": "Secondary text and engraved labels."
    },
    "placeholder": {
      "$value": "#534F48",
      "$extensions": {
        "dark": "#A6A298"
      },
      "$description": "Placeholder text in field wells (ink-2 is too light on deep in the light theme)."
    },
    "line": {
      "$value": "rgba(29, 29, 27, 0.14)",
      "$extensions": {
        "dark": "rgba(236, 232, 222, 0.12)"
      },
      "$description": "Hairlines between rows."
    },
    "signal": {
      "$value": "#FFC81F",
      "$extensions": {
        "dark": "#FFC81F"
      },
      "$description": "The one accent: knob caps, primary keycaps, focus rings, lit indicators."
    },
    "focus": {
      "$value": "#725300",
      "$extensions": {
        "dark": "#FFC81F"
      },
      "$description": "Focus rings: dark amber on the light case (yellow reads 1.2:1 there), yellow in the dark theme."
    },
    "signal-hi": {
      "$value": "#FFD54A",
      "$extensions": {
        "dark": "#FFD54A"
      },
      "$description": "Top of a signal keycap's gradient."
    },
    "signal-glint": {
      "$value": "#FFE07A",
      "$extensions": {
        "dark": "#FFE07A"
      },
      "$description": "Highlight on a knob cap."
    },
    "signal-deep": {
      "$value": "#B88B00",
      "$extensions": {
        "dark": "#B88B00"
      },
      "$description": "Side of a signal keycap, shadow edge of a knob cap."
    },
    "signal-ink": {
      "$value": "#725300",
      "$extensions": {
        "dark": "#FFD24D"
      },
      "$description": "The accent as text on the case: section numbers, hovered indices."
    },
    "on-signal": {
      "$value": "#1D1D1B",
      "$extensions": {
        "dark": "#1D1D1B"
      },
      "$description": "Text on a signal surface."
    },
    "screen": {
      "$value": "#121512",
      "$extensions": {
        "dark": "#0A0B0A"
      },
      "$description": "Display glass behind LED text."
    },
    "led": {
      "$value": "#FFD447",
      "$extensions": {
        "dark": "#FFD447"
      },
      "$description": "Lit LED segments and display text."
    },
    "led-off": {
      "$value": "rgba(255, 212, 71, 0.1)",
      "$extensions": {
        "dark": "rgba(255, 212, 71, 0.1)"
      },
      "$description": "Unlit segments and the untyped remainder of display text."
    },
    "led-rule": {
      "$value": "rgba(255, 212, 71, 0.25)",
      "$extensions": {
        "dark": "rgba(255, 212, 71, 0.25)"
      },
      "$description": "Dashed rules inside a display."
    },
    "led-glow": {
      "$value": "rgba(255, 212, 71, 0.5)",
      "$extensions": {
        "dark": "rgba(255, 212, 71, 0.5)"
      },
      "$description": "Bloom around lit display text."
    },
    "ok": {
      "$value": "#2FB45A",
      "$extensions": {
        "dark": "#2FB45A"
      },
      "$description": "Power and published lamps."
    },
    "warn": {
      "$value": "#E8A21A",
      "$extensions": {
        "dark": "#E8A21A"
      },
      "$description": "Draft, busy and service lamps."
    },
    "hot": {
      "$value": "#FF7A3D",
      "$extensions": {
        "dark": "#FF7A3D"
      },
      "$description": "The peak segment of a meter."
    },
    "danger": {
      "$value": "#A3301B",
      "$extensions": {
        "dark": "#FF7A5C"
      },
      "$description": "Errors and destructive actions (not in the prototype; added for forms and the admin)."
    },
    "hl": {
      "$value": "rgba(255, 255, 255, 0.8)",
      "$extensions": {
        "dark": "rgba(255, 255, 255, 0.09)"
      },
      "$description": "Milled highlight on top edges."
    },
    "sh": {
      "$value": "rgba(70, 58, 30, 0.3)",
      "$extensions": {
        "dark": "rgba(0, 0, 0, 0.6)"
      },
      "$description": "Cast and inner shadow."
    },
    "shade": {
      "$value": "rgba(0, 0, 0, 0.6)",
      "$extensions": {
        "dark": "rgba(0, 0, 0, 0.6)"
      },
      "$description": "Inner shadow of display glass (the same in both themes)."
    },
    "shade-soft": {
      "$value": "rgba(0, 0, 0, 0.25)",
      "$extensions": {
        "dark": "rgba(0, 0, 0, 0.25)"
      },
      "$description": "Shadow inside a knob cap and around lit LEDs."
    },
    "scanline": {
      "$value": "rgba(0, 0, 0, 0.18)",
      "$extensions": {
        "dark": "rgba(0, 0, 0, 0.18)"
      },
      "$description": "Vertical pixel columns on display glass."
    },
    "sheen": {
      "$value": "rgba(255, 255, 255, 0.08)",
      "$extensions": {
        "dark": "rgba(255, 255, 255, 0.08)"
      },
      "$description": "Diagonal reflection on display glass."
    },
    "glint": {
      "$value": "rgba(255, 255, 255, 0.5)",
      "$extensions": {
        "dark": "rgba(255, 255, 255, 0.5)"
      },
      "$description": "Top highlight and text shadow on a signal keycap."
    },
    "module": {
      "$value": "#2A2B2E",
      "$extensions": {
        "dark": "#2A2B2E"
      },
      "$description": "A cartridge (project card): top of its gradient. Dark in both themes."
    },
    "module-deep": {
      "$value": "#121315",
      "$extensions": {
        "dark": "#121315"
      },
      "$description": "A cartridge: bottom of its gradient."
    },
    "module-ink": {
      "$value": "#ECE8DE",
      "$extensions": {
        "dark": "#ECE8DE"
      },
      "$description": "Text on a cartridge."
    },
    "module-ink-2": {
      "$value": "#A6A298",
      "$extensions": {
        "dark": "#A6A298"
      },
      "$description": "Secondary text on a cartridge."
    },
    "pin": {
      "$value": "#E7C46A",
      "$extensions": {
        "dark": "#E7C46A"
      },
      "$description": "Contact pins on a cartridge (top)."
    },
    "pin-deep": {
      "$value": "#9C7A1E",
      "$extensions": {
        "dark": "#9C7A1E"
      },
      "$description": "Contact pins on a cartridge (bottom)."
    },
    "jack-hole": {
      "$value": "#050505",
      "$extensions": {
        "dark": "#050505"
      },
      "$description": "Socket of a jack."
    },
    "jack-ring": {
      "$value": "#8B8778",
      "$extensions": {
        "dark": "#8B8778"
      },
      "$description": "Metal ring of a jack."
    },
    "holo-gold": {
      "$value": "rgba(255, 212, 71, 0.22)",
      "$extensions": {
        "dark": "rgba(255, 212, 71, 0.22)"
      },
      "$description": "Foil band on a cartridge: gold."
    },
    "holo-cyan": {
      "$value": "rgba(140, 220, 255, 0.18)",
      "$extensions": {
        "dark": "rgba(140, 220, 255, 0.18)"
      },
      "$description": "Foil band on a cartridge: cyan."
    },
    "holo-pink": {
      "$value": "rgba(255, 140, 220, 0.14)",
      "$extensions": {
        "dark": "rgba(255, 140, 220, 0.14)"
      },
      "$description": "Foil band on a cartridge: pink."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "label": {
        "$value": ["var(--font-saira)", "Arial Narrow", "sans-serif"],
        "$description": "Engraved labels, keycaps and headings. Saira, width axis 75–125 %."
      },
      "text": {
        "$value": ["var(--font-hanken)", "system-ui", "sans-serif"],
        "$description": "Running text. Hanken Grotesk."
      },
      "led": {
        "$value": ["var(--font-doto)", "Courier New", "monospace"],
        "$description": "Display and LED readouts. Doto, ROND 100."
      },
      "mono": {
        "$value": ["var(--font-martian)", "ui-monospace", "monospace"],
        "$description": "Specs, code and dates. Martian Mono."
      }
    },
    "size": {
      "$type": "dimension",
      "2xs": {
        "$value": "0.625rem"
      },
      "xs": {
        "$value": "0.6875rem"
      },
      "sm": {
        "$value": "0.75rem"
      },
      "md": {
        "$value": "0.875rem"
      },
      "base": {
        "$value": "1.0625rem",
        "$description": "Body text (17 px)."
      },
      "lg": {
        "$value": "1.25rem"
      },
      "xl": {
        "$value": "1.5rem"
      },
      "2xl": {
        "$value": "2rem"
      },
      "3xl": {
        "$value": "2.5rem"
      },
      "4xl": {
        "$value": "4rem"
      },
      "lead": {
        "$value": "clamp(1.05rem, 1rem + 0.35vw, 1.25rem)"
      },
      "heading": {
        "$value": "clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem)",
        "$description": "A list entry's title."
      },
      "section": {
        "$value": "clamp(2rem, 1.4rem + 2.2vw, 3.4rem)",
        "$description": "A manual section's title (§1, §2…)."
      },
      "title": {
        "$value": "clamp(2.4rem, 1.5rem + 3.6vw, 4.6rem)",
        "$description": "A page title."
      },
      "display": {
        "$value": "clamp(2.3rem, 1.2rem + 4.2vw, 5.2rem)",
        "$description": "The hero display."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "extrabold": {
        "$value": 800
      },
      "black": {
        "$value": 900
      }
    },
    "stretch": {
      "$type": "dimension",
      "compressed": {
        "$value": "75%"
      },
      "condensed": {
        "$value": "85%"
      },
      "semi": {
        "$value": "90%"
      },
      "normal": {
        "$value": "100%"
      },
      "wide": {
        "$value": "110%"
      },
      "extra-wide": {
        "$value": "125%"
      }
    },
    "tracking": {
      "$type": "dimension",
      "tight": {
        "$value": "0.01em"
      },
      "snug": {
        "$value": "0.04em"
      },
      "wide": {
        "$value": "0.08em"
      },
      "wider": {
        "$value": "0.12em"
      },
      "widest": {
        "$value": "0.16em"
      }
    },
    "leading": {
      "$type": "number",
      "none": {
        "$value": 0.9
      },
      "tight": {
        "$value": 1
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.6
      },
      "loose": {
        "$value": 1.72
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "xs": {
      "$value": "4px"
    },
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "10px"
    },
    "xl": {
      "$value": "12px"
    },
    "2xl": {
      "$value": "16px"
    },
    "3xl": {
      "$value": "20px"
    },
    "device": {
      "$value": "28px",
      "$description": "The front panel."
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": "inset 0 1px 0 var(--o-hl), 0 1px 0 var(--o-sh), 0 10px 18px -10px var(--o-sh)",
      "$description": "A part that stands proud of the case."
    },
    "recess": {
      "$value": "inset 0 2px 5px var(--o-sh), inset 0 -1px 0 var(--o-hl)",
      "$description": "A well milled into the case."
    },
    "unit": {
      "$value": "inset 0 2px 0 var(--o-hl), 0 16px 26px -20px var(--o-sh), 0 2px 0 var(--o-deep)",
      "$description": "A module bolted onto a panel (admin meters and units)."
    },
    "device": {
      "$value": "inset 0 2px 0 var(--o-hl), inset 0 -3px 0 var(--o-deep)",
      "$description": "The front panel's milled edges. Its cast shadow is `cast`, on a static mount."
    },
    "cast": {
      "$value": "0 2px 0 var(--o-deep)",
      "$description": "The crisp lower edge of a tilting panel, on its static mount (`o-mount`); the soft shadow under it is a gradient, not a blur, so repainting it is cheap."
    },
    "bezel": {
      "$value": "inset 0 3px 10px var(--o-shade), 0 0 0 6px var(--o-deep), 0 1px 0 7px var(--o-hl)",
      "$description": "Display glass in its bezel."
    },
    "knob": {
      "$value": "inset 0 2px 0 var(--o-hl), 0 0 0 5px var(--o-deep), 0 14px 18px -8px var(--o-sh), 0 3px 0 6px var(--o-sh)",
      "$description": "A knob's skirt."
    },
    "module": {
      "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.12)",
      "$description": "A cartridge's top edge. Its cast shadow is `cast-module`, on a static mount."
    },
    "cast-module": {
      "$value": "0 0 0 transparent",
      "$description": "A cartridge's mount has no edge, only the gradient shadow."
    }
  },
  "layout": {
    "$type": "dimension",
    "container": {
      "$value": "1240px"
    },
    "page": {
      "$value": "1060px",
      "$description": "A manual page (post, project)."
    },
    "measure": {
      "$value": "680px",
      "$description": "Running text."
    },
    "header": {
      "$value": "64px"
    },
    "bay": {
      "$value": "250px",
      "$description": "The admin's side bay."
    },
    "gutter": {
      "$value": "16px",
      "$description": "Minimum side gutter; the layout uses max(gutter, safe-area inset)."
    }
  },
  "z": {
    "$type": "number",
    "header": {
      "$value": 20
    },
    "dial": {
      "$value": 25
    },
    "safe-band": {
      "$value": 30
    },
    "float": {
      "$value": 40
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "spring": {
        "$value": "linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%, 1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%, 0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1)",
        "$description": "Overshoot on release: keys, switches, knobs' skirts, list titles."
      },
      "out": {
        "$value": "cubic-bezier(0.2, 0.9, 0.25, 1)",
        "$description": "Power on/off and exploded diagrams."
      },
      "breathe": {
        "$value": "ease-in-out",
        "$description": "Lamps that pulse."
      },
      "blink": {
        "$value": "steps(2, end)",
        "$description": "The display caret."
      },
      "segment": {
        "$value": "steps(1, end)",
        "$description": "Meter segments lighting."
      }
    },
    "duration": {
      "$type": "duration",
      "press": {
        "$value": "60ms",
        "$description": "A key going down."
      },
      "lamp": {
        "$value": "200ms",
        "$description": "An LED or a row background changing."
      },
      "quick": {
        "$value": "250ms",
        "$description": "Focus rings; the outgoing page."
      },
      "needle": {
        "$value": "300ms"
      },
      "spring": {
        "$value": "450ms",
        "$description": "A key, switch or title springing back."
      },
      "hole": {
        "$value": "500ms",
        "$description": "One speaker-grille beat; the incoming page."
      },
      "settle": {
        "$value": "600ms",
        "$description": "A cartridge settling after tilt."
      },
      "rise": {
        "$value": "800ms",
        "$description": "A manual block rising into view."
      },
      "caret": {
        "$value": "900ms"
      },
      "boot": {
        "$value": "1100ms",
        "$description": "The front panel powering on."
      },
      "pulse": {
        "$value": "2400ms"
      },
      "explode": {
        "$value": "4000ms"
      },
      "marquee": {
        "$value": "9000ms"
      }
    },
    "stagger": {
      "$type": "duration",
      "grille": {
        "$value": "12ms"
      },
      "segment": {
        "$value": "22ms"
      },
      "type": {
        "$value": "34ms",
        "$description": "Per character on the display; a space takes 70ms."
      },
      "type-space": {
        "$value": "70ms"
      },
      "counter": {
        "$value": "140ms"
      }
    },
    "reduced": {
      "$type": "duration",
      "$description": "Reduced motion (system setting or `html.calm`): nothing moves; feedback and page changes fade.",
      "feedback": {
        "$value": "120ms",
        "$description": "Hover, press and focus feedback as a colour change."
      },
      "crossfade": {
        "$value": "150ms",
        "$description": "Page changes (View Transitions) as a cross-fade."
      }
    }
  }
}
