{
  "$description": "Orkide skin tokens (W3C Design Tokens format). `$value` is the blue print (the default theme); `$extensions.light` is the white print. `pnpm --filter @orkide/ui tokens` builds src/styles/tokens.css and src/tokens/tokens.ts from this file.",
  "color": {
    "$type": "color",
    "paper": {
      "$value": "#0E3F7C",
      "$extensions": { "light": "#F2F5F9" },
      "$description": "The drawing sheet: the page background."
    },
    "paper-2": {
      "$value": "#0A3369",
      "$extensions": { "light": "#E4EAF3" },
      "$description": "Wells: fields, code, table heads."
    },
    "paper-3": {
      "$value": "#12488A",
      "$extensions": { "light": "#FFFFFF" },
      "$description": "Raised sheets: menus, dialogs, plates."
    },
    "ink": {
      "$value": "#F1F6FF",
      "$extensions": { "light": "#0D3A73" },
      "$description": "Primary text."
    },
    "ink-2": {
      "$value": "#A9C3E7",
      "$extensions": { "light": "#4A6892" },
      "$description": "Secondary text and labels."
    },
    "placeholder": {
      "$value": "#A9C3E7",
      "$extensions": { "light": "#4A6892" },
      "$description": "Placeholder text in wells."
    },
    "line": {
      "$value": "#DCE9FB",
      "$extensions": { "light": "#164C8F" },
      "$description": "Drawn lines: borders, outlines, the drawings."
    },
    "line-2": {
      "$value": "rgba(220, 233, 251, 0.5)",
      "$extensions": { "light": "rgba(22, 76, 143, 0.5)" },
      "$description": "Secondary rules and dividers."
    },
    "line-3": {
      "$value": "rgba(220, 233, 251, 0.2)",
      "$extensions": { "light": "rgba(22, 76, 143, 0.2)" },
      "$description": "Hairlines between rows, hatching, hidden lines."
    },
    "grid": {
      "$value": "rgba(214, 231, 255, 0.065)",
      "$extensions": { "light": "rgba(22, 76, 143, 0.06)" },
      "$description": "The 8 px drafting grid."
    },
    "grid-major": {
      "$value": "rgba(214, 231, 255, 0.13)",
      "$extensions": { "light": "rgba(22, 76, 143, 0.13)" },
      "$description": "Every fifth grid line (40 px)."
    },
    "mark": {
      "$value": "#FF7A61",
      "$extensions": { "light": "#D8452B" },
      "$description": "The one accent, a redline: markers, the focus ring, revision clouds, the cutting plane."
    },
    "mark-ink": {
      "$value": "#FFA28E",
      "$extensions": { "light": "#B23519" },
      "$description": "The accent as text: sheet numbers, kickers, hand notes."
    },
    "mark-fill": {
      "$value": "#D23F27",
      "$extensions": { "light": "#C93A21" },
      "$description": "The primary button and selected balloons."
    },
    "on-mark": {
      "$value": "#FFFFFF",
      "$extensions": { "light": "#FFFFFF" },
      "$description": "Text on mark-fill."
    },
    "focus": {
      "$value": "#FF7A61",
      "$extensions": { "light": "#D8452B" },
      "$description": "Focus rings."
    },
    "ok": {
      "$value": "#8FE3C8",
      "$extensions": { "light": "#16775B" },
      "$description": "Published, sent, healthy."
    },
    "warn": {
      "$value": "#FFD27A",
      "$extensions": { "light": "#8A5A00" },
      "$description": "Drafts, samples, warnings, the text selection."
    },
    "danger": {
      "$value": "#FFA28E",
      "$extensions": { "light": "#B23519" },
      "$description": "Errors (the redline as text)."
    },
    "shade": {
      "$value": "rgba(3, 16, 42, 0.3)",
      "$extensions": { "light": "rgba(13, 58, 115, 0.14)" },
      "$description": "Hard offset shadows under slips and menus."
    },
    "lamp": {
      "$value": "rgba(186, 232, 255, 0.95)",
      "$extensions": { "light": "rgba(70, 150, 255, 0.55)" },
      "$description": "The exposure lamp that sweeps across a print change."
    },
    "exposure": {
      "$value": "rgba(150, 200, 255, 0.08)",
      "$extensions": { "light": "rgba(22, 76, 143, 0.035)" },
      "$description": "The uneven exposure at the top of the sheet."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "var(--font-archivo)",
          "Arial Narrow",
          "Arial",
          "sans-serif"
        ],
        "$description": "Lettering: titles, labels on buttons (set condensed through `font-stretch`)."
      },
      "text": {
        "$value": ["var(--font-archivo)", "system-ui", "sans-serif"],
        "$description": "Running text (the same variable family at normal width)."
      },
      "mono": {
        "$value": ["var(--font-chivo-mono)", "ui-monospace", "monospace"],
        "$description": "Labels, sheet numbers, data, code."
      },
      "hand": {
        "$value": ["var(--font-shantell)", "Segoe Print", "cursive"],
        "$description": "Redline notes. Use sparingly."
      }
    },
    "size": {
      "$type": "dimension",
      "3xs": { "$value": "0.625rem" },
      "2xs": { "$value": "0.6875rem" },
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.8125rem" },
      "md": { "$value": "0.9375rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.1875rem" },
      "xl": { "$value": "1.5rem" },
      "2xl": { "$value": "2rem" },
      "3xl": { "$value": "2.5rem" },
      "4xl": { "$value": "3.5rem" },
      "lead": {
        "$value": "clamp(1.05rem, 1rem + 0.3vw, 1.1875rem)",
        "$description": "Lead paragraphs."
      },
      "heading": {
        "$value": "clamp(1.6rem, 1.2rem + 1.2vw, 2.1rem)",
        "$description": "Headings inside a page."
      },
      "section": {
        "$value": "clamp(2.1rem, 1.3rem + 2.8vw, 3.3rem)",
        "$description": "Section titles."
      },
      "title": {
        "$value": "clamp(2.5rem, 1.4rem + 3.8vw, 4.8rem)",
        "$description": "Page titles."
      },
      "display": {
        "$value": "clamp(2.75rem, 1.4rem + 4.6vw, 5.6rem)",
        "$description": "The cover sheet's title."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "normal": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 780 },
      "black": { "$value": 850 }
    },
    "stretch": {
      "$type": "dimension",
      "display": {
        "$value": "66%",
        "$description": "Titles: condensed capitals."
      },
      "condensed": { "$value": "72%" },
      "narrow": { "$value": "80%" },
      "semi": {
        "$value": "86%",
        "$description": "Button and navigation lettering."
      },
      "normal": { "$value": "100%" },
      "expanded": { "$value": "125%", "$description": "The wordmark." }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "0.004em" },
      "snug": { "$value": "0.02em" },
      "normal": { "$value": "0.06em" },
      "wide": { "$value": "0.1em" },
      "wider": { "$value": "0.13em" },
      "widest": { "$value": "0.16em" }
    },
    "leading": {
      "$type": "number",
      "none": { "$value": 0.93 },
      "tight": { "$value": 1.05 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.6 },
      "loose": { "$value": 1.7 }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Drawings have square corners; only avatars and balloons are round (`rounded-full`).",
    "xs": { "$value": "0px" },
    "sm": { "$value": "0px" },
    "md": { "$value": "0px" },
    "lg": { "$value": "0px" },
    "xl": { "$value": "0px" },
    "2xl": { "$value": "0px" },
    "3xl": { "$value": "0px" }
  },
  "shadow": {
    "$type": "shadow",
    "slip": {
      "$value": "6px 6px 0 var(--o-shade)",
      "$description": "A slip of paper lying on the sheet: menus, dialogs, toasts."
    },
    "inset": {
      "$value": "inset 0 0 0 1px var(--o-line-3)",
      "$description": "A well's inner edge."
    }
  },
  "layout": {
    "$type": "dimension",
    "container": { "$value": "1320px" },
    "measure": { "$value": "44rem", "$description": "Running text." },
    "header": {
      "$value": "70px",
      "$description": "The title strip, with its padding."
    },
    "frame": {
      "$value": "10px",
      "$description": "Margin outside the sheet border."
    },
    "ruler": {
      "$value": "22px",
      "$description": "The zone ruler inside the border."
    },
    "room": {
      "$value": "30px",
      "$description": "Extra side room so content clears the rulers."
    },
    "palette": {
      "$value": "240px",
      "$description": "The admin's tool palette."
    },
    "gutter": {
      "$value": "16px",
      "$description": "Minimum side gutter; the layout uses max(gutter, safe-area inset)."
    }
  },
  "z": {
    "$type": "number",
    "raised": { "$value": 10 },
    "header": { "$value": 40 },
    "frame": { "$value": 50 },
    "status": { "$value": 51 },
    "float": { "$value": 60 },
    "toast": { "$value": 70 },
    "lamp": { "$value": 80 },
    "cursor": { "$value": 85 }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "spring": {
        "$value": "linear(0, 0.034 2.1%, 0.141 4.4%, 0.616 13.3%, 0.82 18.4%, 0.952 24.1%, 1.03 30.6%, 1.054 35.3%, 1.059 39.6%, 1.046 46.3%, 1.012 58.2%, 0.999 69.1%, 0.996 79.6%, 1)",
        "$description": "A gentle overshoot: buttons, rings, sliders."
      },
      "bounce": {
        "$value": "linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%, 1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%, 0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1.004 83.8%, 1)",
        "$description": "A livelier overshoot: switches, balloons, tags."
      },
      "out": {
        "$value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "$description": "Arrivals: lines drawing, blocks rising, sheets sliding in."
      },
      "in-out": {
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)",
        "$description": "The outgoing sheet and the plotter's pen."
      },
      "lamp": {
        "$value": "cubic-bezier(0.45, 0, 0.55, 1)",
        "$description": "The exposure lamp's sweep."
      }
    },
    "duration": {
      "$type": "duration",
      "press": { "$value": "60ms", "$description": "A button going down." },
      "hover": {
        "$value": "200ms",
        "$description": "Colour and background changes."
      },
      "spring": {
        "$value": "500ms",
        "$description": "A button or tag springing back."
      },
      "draw": {
        "$value": "900ms",
        "$description": "A rule or a section bubble drawing itself."
      },
      "rise": {
        "$value": "900ms",
        "$description": "A block rising into view."
      },
      "frame": {
        "$value": "1000ms",
        "$description": "The sheet border drawing on load."
      },
      "plot": {
        "$value": "1700ms",
        "$description": "A plate's drawing plotted by pen."
      },
      "lamp": {
        "$value": "950ms",
        "$description": "The exposure lamp crossing the sheet."
      },
      "sheet-out": { "$value": "420ms", "$description": "The outgoing page." },
      "sheet-in": { "$value": "600ms", "$description": "The incoming page." },
      "stamp": { "$value": "560ms", "$description": "A stamp landing." },
      "count": { "$value": "1300ms", "$description": "A number counting up." }
    },
    "stagger": {
      "$type": "duration",
      "zone": {
        "$value": "35ms",
        "$description": "Zone letters appearing along the ruler."
      },
      "list": {
        "$value": "60ms",
        "$description": "Rows and blocks rising one after another."
      },
      "plate": { "$value": "160ms", "$description": "Plates starting to plot." }
    },
    "reduced": {
      "$type": "duration",
      "$description": "Reduced motion (system setting or `html.calm`): nothing moves; feedback and page changes fade.",
      "feedback": {
        "$value": "120ms",
        "$description": "Hover, press and focus feedback as a colour change."
      },
      "crossfade": {
        "$value": "150ms",
        "$description": "Page changes (View Transitions) as a cross-fade."
      }
    }
  }
}
