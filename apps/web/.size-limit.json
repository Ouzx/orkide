[
  {
    "name": "Skin motion and cover drawing (frame, blueprint, hero, stack)",
    "path": [
      "dist/client/_astro/frame.*.js",
      "dist/client/_astro/blueprint.*.js",
      "dist/client/_astro/Hero.astro_*.js",
      "dist/client/_astro/Stack.astro_*.js"
    ],
    "limit": "9.5 kB"
  },
  {
    "name": "React runtime (shared by every island)",
    "path": "dist/client/_astro/client.*.js",
    "limit": "60 kB"
  },
  {
    "name": "Admin editor (Tiptap, admin only)",
    "path": "dist/client/_astro/document-form.*.js",
    "limit": "125 kB"
  },
  {
    "name": "Admin app shell",
    "path": "dist/client/_astro/admin-app.*.js",
    "limit": "55 kB"
  },
  {
    "name": "Design atlas (page script and preview helpers, /atlas only; specimens count in the total)",
    "path": [
      "dist/client/_astro/atlas.astro_*.js",
      "dist/client/_astro/preview-kit.*.js"
    ],
    "limit": "6 kB"
  },
  {
    "name": "All client JavaScript",
    "path": "dist/client/_astro/*.js",
    "limit": "400 kB"
  }
]
