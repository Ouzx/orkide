{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orkide-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
  },
  "upload_source_maps": true,
  // Rendered pages opt in through Astro route caching (`Cloudflare-CDN-Cache-Control` + `Cache-Tag`).
  "cache": { "enabled": true },
  // Lets the cache provider tag responses with the deployed version.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": { "binding": "ASSETS" },
  // The public origin (`site` in astro.config.ts). A product sets its own domain here.
  "routes": [{ "pattern": "orkide.ouzx.me", "custom_domain": true }],

  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFLfPVF6jH6xMnSu",
    // This Worker's workers.dev address: its pages redirect to the public origin (src/worker.ts).
    "WORKERS_DEV_HOST": "orkide-web.ouzx.workers.dev",
  },

  // `/api/*` is forwarded to the API Worker in-process: same origin, no CORS, no network hop.
  "services": [{ "binding": "API", "service": "orkide-api" }],
}
