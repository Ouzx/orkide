---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";
import type { ProjectSummary } from "@orkide/validators/content";

interface Props {
  project: ProjectSummary;
  headingLevel?: 2 | 3;
  /** A picture of the project beside its own copy (home page): no link, hidden from assistive tech. */
  decorative?: boolean;
}

const { project, headingLevel = 2, decorative = false } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
const href = localizeHref(`/portfolio/${project.slug}`, options);
const Heading = `h${headingLevel}` as const;
const Tag = decorative ? "div" : "a";
---

<!-- A project as a cartridge: a dark module with a signal sticker that tilts toward the pointer. -->
<div class="o-mount o-mount-module">
  <Tag
    class="o-cartridge"
    href={decorative ? undefined : href}
    aria-hidden={decorative ? "true" : undefined}
    data-tilt="cartridge"
  >
    <div class="o-cartridge-row">
      <span>{project.tags.map((tag) => tag.name).join(" · ")}</span>
      {project.featured && <span>{m.portfolio_featured({}, options)}</span>}
    </div>
    <div class="o-sticker">
      <span>{m.portfolio_cartridge({}, options)}</span>
      {
        decorative ? (
          <b>{project.title}</b>
        ) : (
          <Heading class="m-0">
            <b>{project.title}</b>
          </Heading>
        )
      }
    </div>
    <div class="o-cartridge-row">
      <div class="o-pins" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i>
      </div>
      {
        !decorative && (
          <span>
            {m.portfolio_details({}, options)} <span aria-hidden="true">→</span>
          </span>
        )
      }
    </div>
  </Tag>
</div>
