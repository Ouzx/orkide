---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";
import type { ProjectSummary } from "@orkide/validators/content";

import { sheetNumber } from "@/shared/lib/sheet.ts";

import PlateArt from "./PlateArt.astro";

interface Props {
  project: ProjectSummary;
  headingLevel?: 2 | 3;
  /** The wide plate beside the featured project's copy (home page): no link, hidden from assistive tech. */
  decorative?: boolean;
}

const { project, headingLevel = 2, decorative = false } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
const href = localizeHref(`/portfolio/${project.slug}`, options);
const Heading = `h${headingLevel}` as const;
const sheet = sheetNumber("P", project.publishedAt);
const year = project.publishedAt?.slice(0, 4) ?? "—";
---

<!-- A project as a plate: a drawing generated from its slug, a title strip and its summary. -->{
  decorative ? (
    <div class="o-plate" data-lead data-dim aria-hidden="true">
      <PlateArt seed={project.slug} lead />
      <div class="o-plate-tb">
        <span>{sheet}</span>
        <span>{project.title}</span>
        <span>{m.plate_scale({}, options)}</span>
        <span>{year}</span>
      </div>
    </div>
  ) : (
    <article class="o-plate" data-dim>
      <PlateArt seed={project.slug} />
      <div class="o-plate-tb" aria-hidden="true">
        <span>{sheet}</span>
        <span>{project.title}</span>
        <span>{m.plate_scale({}, options)}</span>
        <span>{year}</span>
      </div>
      <div class="o-plate-body">
        <Heading>
          <a href={href}>{project.title}</a>
        </Heading>
        <p>{project.summary}</p>
        {project.tags.length > 0 && (
          <ul class="o-tags" aria-label={m.blog_tags({}, options)}>
            {project.tags.map((tag) => (
              <li class="o-tag">{tag.name}</li>
            ))}
          </ul>
        )}
      </div>
    </article>
  )
}
