---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";
import { buttonVariants } from "@orkide/ui/components/button";
import { cn } from "@orkide/ui/lib/utils";
import { ArrowRight } from "lucide-react";

import MediaSlot from "@/shared/media/MediaSlot.astro";

interface Props {
  /** The `hero-scene` feature flag. */
  sceneEnabled: boolean;
}

const { sceneEnabled } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
---

<section
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden border-b"
>
  <div
    class="absolute inset-0 -z-20 bg-grid [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)] opacity-40"
  >
  </div>
  <div
    class="absolute -top-40 -left-40 -z-20 size-[36rem] rounded-full bg-orchid/20 blur-3xl"
  >
  </div>
  <div
    class="absolute -right-40 -bottom-40 -z-20 size-[30rem] rounded-full bg-aurora/15 blur-3xl"
  >
  </div>

  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:py-28"
  >
    <div class="relative">
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full border glass-subtle px-3 py-1 font-mono text-xs tracking-widest text-muted-foreground uppercase"
      >
        <span
          class="size-1.5 animate-pulse rounded-full bg-primary"
          aria-hidden="true"></span>
        {m.home_hero_eyebrow({}, options)}
      </p>
      <h1
        id="hero-title"
        class="text-gradient text-display font-semibold text-balance"
      >
        {m.home_hero_title({}, options)}
      </h1>
      <p class="mt-6 max-w-xl text-lead text-pretty text-muted-foreground">
        {m.home_hero_lead({}, options)}
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={localizeHref("/portfolio", options)}
          class={cn(buttonVariants({ size: "pill" }), "group shine")}
        >
          {m.home_hero_cta_work({}, options)}
          <ArrowRight
            aria-hidden="true"
            className="transition-transform group-hover:translate-x-0.5"
          />
        </a>
        <a
          href={localizeHref("/contact", options)}
          class={cn(
            buttonVariants({ size: "pill", variant: "outline" }),
            "live-border glass-subtle"
          )}
        >
          {m.home_hero_cta_contact({}, options)}
        </a>
      </div>
    </div>

    <!--
      The orchid artwork is static and cacheable; once the page is idle, a WebGL layer of
      drifting pollen fades in around it (skipped for reduced motion, Save-Data or no WebGL).
    -->
    <div
      class="relative -mt-6 aspect-square w-full max-w-xs justify-self-center sm:max-w-md lg:mt-0 lg:max-w-none"
    >
      <div
        class="absolute inset-0 [mask-image:radial-gradient(circle,black_40%,transparent_70%)]"
      >
        <MediaSlot
          id="home-hero-poster"
          sizes="(min-width: 1024px) 560px, (min-width: 640px) 448px, 320px"
          class="h-full"
        />
      </div>
      {
        sceneEnabled && (
          <div
            data-hero-scene
            aria-hidden="true"
            class="absolute inset-0 animate-in duration-1000 fade-in"
            hidden
          />
        )
      }
    </div>
  </div>
</section>

<script>
  /*
   * Progressive pollen layer. A plain script rather than a React island, so the home page ships no
   * framework runtime: after the page is idle, and unless the visitor prefers reduced motion, is
   * saving data or lacks WebGL 2, the Three.js chunk is fetched and mounted. Any failure leaves the
   * poster in place. The host only exists when the `hero-scene` flag is on.
   */
  const host = document.querySelector<HTMLElement>("[data-hero-scene]");

  const supportsWebGl = (): boolean => {
    try {
      return document.createElement("canvas").getContext("webgl2") !== null;
    } catch {
      return false;
    }
  };

  const saveData = (): boolean =>
    (navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection?.saveData === true;

  /** Safari lacks `requestIdleCallback`; a short timeout is a fine stand-in after load. */
  // oxlint-disable-next-line promise/prefer-await-to-callbacks
  const whenIdle = (callback: () => void): void => {
    if ("requestIdleCallback" in globalThis) {
      requestIdleCallback(callback, { timeout: 4000 });
    } else {
      setTimeout(callback, 1500);
    }
  };

  if (
    host &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    !saveData() &&
    supportsWebGl()
  ) {
    whenIdle(async () => {
      try {
        const { mountPollenScene } = await import("./pollen-scene.ts");
        host.hidden = false;
        mountPollenScene(host);
      } catch {
        host.hidden = true;
      }
    });
  }
</script>
