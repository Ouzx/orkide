---
/** The five stages of a request, drawn as small symbols: edge, worker, D1, browser, pixel. */
interface Props {
  index: number;
}
const { index } = Astro.props;
---

<svg class="o-stage-icon" viewBox="0 0 64 64" aria-hidden="true">
  {
    index === 0 && (
      <>
        <circle cx="30" cy="34" r="22" />
        <ellipse cx="30" cy="34" rx="9" ry="22" />
        <line x1="8" y1="34" x2="52" y2="34" />
        <path d="M12 22 Q 30 28 48 22 M 12 46 Q 30 40 48 46" />
        <path
          data-hl
          d="M50 6 C 44 6 42 11 44 15 L 50 24 L 56 15 C 58 11 56 6 50 6 Z"
        />
      </>
    )
  }
  {
    index === 1 && (
      <>
        <rect x="4" y="8" width="30" height="22" />
        <rect x="30" y="36" width="30" height="22" />
        <path data-hl d="M26 30 V 47 H 30" stroke-dasharray="6 3 2 3" />
        <path d="M10 15 H 22 M 10 20 H 28 M 36 43 H 50 M 36 48 H 54" />
      </>
    )
  }
  {
    index === 2 && (
      <>
        <ellipse cx="32" cy="12" rx="22" ry="7" />
        <path d="M10 12 V 50 C 10 54 20 57 32 57 C 44 57 54 54 54 50 V 12" />
        <path data-hl d="M10 25 C 10 29 20 32 32 32 C 44 32 54 29 54 25" />
        <path d="M10 38 C 10 42 20 45 32 45 C 44 45 54 42 54 38" />
      </>
    )
  }
  {
    index === 3 && (
      <>
        <rect x="4" y="10" width="56" height="44" />
        <line x1="4" y1="19" x2="60" y2="19" />
        <circle cx="10" cy="14.5" r="1.6" />
        <circle cx="15" cy="14.5" r="1.6" />
        <circle cx="20" cy="14.5" r="1.6" />
        <path data-hl d="M12 28 H 40 M 12 34 H 52 M 12 40 H 46" />
        <rect x="12" y="45" width="14" height="5" />
      </>
    )
  }
  {
    index >= 4 && (
      <>
        <path d="M8 8 H 56 V 56 H 8 Z M 20 8 V 56 M 32 8 V 56 M 44 8 V 56 M 8 20 H 56 M 8 32 H 56 M 8 44 H 56" />
        <rect data-fill x="32" y="20" width="12" height="12" />
        <path data-hl d="M38 26 L 58 6 M 52 6 H 58 V 12" />
      </>
    )
  }
</svg>
