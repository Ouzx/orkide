---
import { m } from "@orkide/i18n/messages";
import type { SiteContent } from "@orkide/validators/site";

import SectionHead from "@/shared/components/SectionHead.astro";

interface Props {
  /** The section's words: the admin's saved section, else the shipped one. */
  content: SiteContent["inside"];
}

const { content } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
const tag = m.home_schedule({}, options);
const pad = (n: number) => n.toString().padStart(2, "0");
---

<!-- What the site is made of: a schedule of quantities, then its features as general notes. -->
<section
  id="inside"
  aria-labelledby="inside-title"
  class="o-wrap o-sec"
  data-reveal
  data-section-title={`§2 · ${tag}`}
>
  <SectionHead
    number={2}
    tag={tag}
    kicker={content.kicker}
    id="inside-title"
    title={content.title}
  />
  <div class="o-sched">
    <div>
      <p class="o-lead">{content.lead}</p>
      <div class="o-qty-head" aria-hidden="true">
        <span>#</span><span>{m.home_qty({}, options)}</span><span
          >{m.home_item({}, options)}</span
        >
      </div>
      <ul class="o-qtys">
        {
          content.meters.map((meter, index) => (
            <li class="o-qty">
              <span class="o-qty-i" aria-hidden="true">
                {pad(index + 1)}
              </span>
              <span class="o-qty-v">
                <span
                  data-count={
                    /^\d+$/u.test(meter.value) ? meter.value : undefined
                  }
                >
                  {meter.value}
                </span>
                {meter.unit && <small>{meter.unit}</small>}
              </span>
              <span class="o-qty-l">{meter.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="o-label mt-0 mb-3.5">{m.home_notes({}, options)}</h3>
      <ol class="o-notes">
        {
          content.features.map((feature, index) => (
            <li class="o-note">
              <span class="o-note-n" aria-hidden="true">
                {index + 1}
              </span>
              <span class="o-note-k">{feature.name}</span>
              <h4 class="o-h3">{feature.title}</h4>
              <p>{feature.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
