---
import { m } from "@orkide/i18n/messages";

import { formatDate } from "@/shared/lib/i18n.ts";

interface Props {
  publishedAt: string | null;
  readingTimeMinutes: number;
  class?: string;
}

const { publishedAt, readingTimeMinutes, class: className } = Astro.props;
const { locale } = Astro.locals;
---

<p class:list={["text-muted-foreground flex flex-wrap items-center gap-x-2 font-mono text-xs tracking-wide uppercase", className]}>
  {publishedAt && <time datetime={publishedAt}>{formatDate(publishedAt, locale)}</time>}
  {publishedAt && <span aria-hidden="true">·</span>}
  <span>{m.blog_reading_time({ minutes: readingTimeMinutes.toString() }, { locale })}</span>
</p>
