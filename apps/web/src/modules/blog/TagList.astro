---
import type { Term } from "@orkide/validators/taxonomy";
import { localizeHref } from "@orkide/i18n/runtime";

interface Props {
  tags: readonly Term[];
  label: string;
}

const { tags, label } = Astro.props;
const { locale } = Astro.locals;
---

{
  tags.length > 0 && (
    <ul
      class="relative z-10 m-0 inline-flex list-none flex-wrap gap-x-3 gap-y-1 p-0"
      aria-label={label}
    >
      {tags.map((tag) => (
        <li>
          <a
            href={localizeHref(`/blog/tag/${tag.slug}`, { locale })}
            class="font-mono text-sm text-ink no-underline hover:text-signal-ink"
          >
            #{tag.name}
          </a>
        </li>
      ))}
    </ul>
  )
}
