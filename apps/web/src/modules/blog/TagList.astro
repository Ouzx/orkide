---
import type { Term } from "@orkide/validators/taxonomy";
import { localizeHref } from "@orkide/i18n/runtime";

interface Props {
  tags: readonly Term[];
  label: string;
}

const { tags, label } = Astro.props;
const { locale } = Astro.locals;
---

{
  tags.length > 0 && (
    <ul class="relative z-10 flex flex-wrap gap-2" aria-label={label}>
      {tags.map((tag) => (
        <li>
          <a
            href={localizeHref(`/blog/tag/${tag.slug}`, { locale })}
            class="rounded-full border glass-subtle px-2.5 py-0.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-foreground"
          >
            #{tag.name}
          </a>
        </li>
      ))}
    </ul>
  )
}
