---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";
import type { PostSummary } from "@orkide/validators/content";

import MediaImage from "@/shared/media/MediaImage.astro";
import Picture from "@/shared/media/Picture.astro";

import PostMeta from "./PostMeta.astro";
import TagList from "./TagList.astro";

interface Props {
  post: PostSummary;
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const { locale } = Astro.locals;
const href = localizeHref(`/blog/${post.slug}`, { locale });
const Heading = `h${headingLevel}` as const;
---

<article
  data-spotlight
  class="group live-border spotlight flex reveal flex-col overflow-hidden rounded-2xl border glass transition-transform duration-500 ease-out-expo hover:-translate-y-1 has-focus-visible:ring-2 has-focus-visible:ring-ring"
>
  {
    post.cover ? (
      <MediaImage
        media={post.cover}
        sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
        class="aspect-[16/9] border-b"
      />
    ) : (
      <Picture
        id="default-post-cover"
        sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
        class="aspect-[16/9] border-b"
        imgClass="transition-transform duration-700 ease-out-expo group-hover:scale-103"
      />
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-6">
    <PostMeta
      publishedAt={post.publishedAt}
      readingTimeMinutes={post.readingTimeMinutes}
    />
    <Heading class="text-xl font-semibold tracking-tight text-balance">
      <a href={href} class="outline-none after:absolute after:inset-0">
        {post.title}
      </a>
    </Heading>
    <p class="line-clamp-3 text-pretty text-muted-foreground">{post.summary}</p>
    <div class="mt-auto pt-2">
      <TagList tags={post.tags} label={m.blog_tags({}, { locale })} />
    </div>
  </div>
</article>
