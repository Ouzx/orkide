---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";
import type { PostSummary } from "@orkide/validators/content";

import { formatDate } from "@/shared/lib/i18n.ts";
import { sheetNumber } from "@/shared/lib/sheet.ts";

interface Props {
  post: PostSummary;
  headingLevel?: 2 | 3;
  /** The newest sheet in the index: the motion layer draws a revision cloud around it. */
  latest?: boolean;
}

const { post, headingLevel = 2, latest = false } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
const href = localizeHref(`/blog/${post.slug}`, options);
const Heading = `h${headingLevel}` as const;
---

<!-- A post as a row of the drawing index: sheet number, title and summary, discipline, date, length. -->
<li class="o-row" data-cloud={latest ? "Δ" : undefined} data-morph-href={href}>
  <span class="o-row-no" aria-hidden="true" data-morph="no">
    {sheetNumber("D", post.publishedAt)}
  </span>
  <div class="min-w-0">
    <Heading class="o-row-title"
      ><a href={href} data-morph="title">{post.title}</a></Heading
    >
    <p class="o-row-sum">{post.summary}</p>
  </div>
  <span class="o-row-meta">
    {
      post.category && (
        <a href={localizeHref(`/blog/category/${post.category.slug}`, options)}>
          {post.category.name}
        </a>
      )
    }
  </span>
  <span class="o-row-meta">
    {
      post.publishedAt && (
        <time datetime={post.publishedAt}>
          {formatDate(post.publishedAt, locale, "medium")}
        </time>
      )
    }
  </span>
  <span class="o-row-meta">
    {
      m.blog_reading_time(
        { minutes: post.readingTimeMinutes.toString() },
        options
      )
    }
  </span>
  <span class="o-row-go" aria-hidden="true">{m.index_open({}, options)} →</span>
</li>
