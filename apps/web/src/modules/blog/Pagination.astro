---
import { m } from "@orkide/i18n/messages";
import { ArrowLeft, ArrowRight } from "lucide-react";

interface Props {
  /** Path of the first page (localized). */
  basePath: string;
  /** Whether the current page is not the first one. */
  hasPrevious: boolean;
  nextCursor: string | null;
}

const { basePath, hasPrevious, nextCursor } = Astro.props;
const { locale } = Astro.locals;
const link = "hover:bg-muted inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors";
---

{
  (hasPrevious || nextCursor) && (
    <nav aria-label={m.blog_pagination({}, { locale })} class="mt-12 flex justify-between gap-4">
      {hasPrevious ? (
        <a href={basePath} class={link}>
          <ArrowLeft aria-hidden="true" className="size-4" />
          {m.blog_newer({}, { locale })}
        </a>
      ) : (
        <span />
      )}
      {nextCursor && (
        <a href={`${basePath}?cursor=${encodeURIComponent(nextCursor)}`} rel="next" class={link}>
          {m.blog_older({}, { locale })}
          <ArrowRight aria-hidden="true" className="size-4" />
        </a>
      )}
    </nav>
  )
}
