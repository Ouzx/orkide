---
import { m } from "@orkide/i18n/messages";

import PostIndex from "@/modules/blog/PostIndex.astro";
import { findTerm, getTaxonomy, listPosts } from "@/modules/blog/blog.data.ts";
import { cachePage } from "@/shared/lib/cache.ts";
import { notFound } from "@/shared/lib/not-found.ts";

const { locale } = Astro.locals;
const slug = Astro.params.slug ?? "";
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

const [found, taxonomy] = await Promise.all([
  findTerm("tag", slug, locale),
  getTaxonomy(locale),
]);
if (!found) {
  return notFound(Astro, locale);
}
const posts = await listPosts({ cursor, locale, tag: slug });

cachePage(Astro, "posts", "taxonomy");
---

<PostIndex
  title={m.blog_tag_title({ name: found.term.name }, { locale })}
  description={m.blog_description({}, { locale })}
  alternates={found.alternates}
  basePath={found.alternates[locale] ?? Astro.url.pathname}
  posts={posts}
  categories={taxonomy.categories}
  cursor={cursor}
/>
