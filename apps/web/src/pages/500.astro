---
import { baseLocale } from "@orkide/i18n";
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";
import { buttonVariants } from "@orkide/ui/components/button";
import { cn } from "@orkide/ui/lib/utils";

import BaseLayout from "@/shared/layouts/BaseLayout.astro";
import Picture from "@/shared/media/Picture.astro";
import { pageAlternates } from "@/shared/lib/i18n.ts";

// Errors can surface before the i18n middleware has run; the layout reads the locale too.
Astro.locals.locale ??= baseLocale;
const { locale } = Astro.locals;
const options = { locale };
Astro.response.status = 500;
---

<BaseLayout
  title={m.error_page_title({}, options)}
  description={m.error_page_body({}, options)}
  alternates={pageAlternates("/")}
  noindex
>
  <section
    class="mx-auto flex max-w-2xl flex-col items-center px-4 py-20 text-center"
  >
    <Picture
      id="server-error"
      sizes="288px"
      priority
      class="size-64 rounded-full border shadow-2xl shadow-orchid/20 dark:size-72 dark:rounded-none dark:border-0 dark:[mask-image:radial-gradient(circle,black_45%,transparent_70%)] dark:shadow-none"
    />
    <p class="mt-6 text-gradient font-mono text-7xl font-semibold dark:-mt-8">
      500
    </p>
    <h1 class="mt-6 text-3xl font-semibold tracking-tight">
      {m.error_page_title({}, options)}
    </h1>
    <p class="mt-4 text-muted-foreground">{m.error_page_body({}, options)}</p>
    <a
      href={localizeHref("/", options)}
      class={cn(buttonVariants({ size: "pill" }), "mt-10")}
    >
      {m.error_retry({}, options)}
    </a>
  </section>
</BaseLayout>
