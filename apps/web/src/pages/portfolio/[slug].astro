---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";

import { getProject } from "@/modules/portfolio/portfolio.data.ts";
import DocumentArticle from "@/shared/components/DocumentArticle.astro";
import { asVisitor } from "@/shared/lib/forward.ts";
import { cachePage } from "@/shared/lib/cache.ts";
import { parseDocumentParam, markdownResponse } from "@/shared/lib/markdown.ts";
import { notFound } from "@/shared/lib/not-found.ts";
import { languageTag } from "@/shared/lib/i18n.ts";
import { absoluteUrl } from "@/shared/site.ts";
import { breadcrumbNode, graph, projectNode } from "@/shared/seo/json-ld.ts";

const { locale } = Astro.locals;
const options = { locale };
const { slug, markdown } = parseDocumentParam(Astro.params.slug);
const project = await getProject(slug, locale, asVisitor(Astro.request));
if (!project) {
  return notFound(Astro, locale);
}

const path = localizeHref(`/portfolio/${project.slug}`, options);
cachePage(Astro, "projects");
// `<url>.md` and `Accept: text/markdown` (rewritten by the middleware) get the Markdown variant.
if (markdown) {
  return markdownResponse(project, absoluteUrl(path));
}
const portfolioPath = localizeHref("/portfolio", options);
const year = new Intl.DateTimeFormat(languageTag[locale], {
  month: "short",
  year: "numeric",
});
const timeline = project.startedAt
  ? `${year.format(new Date(project.startedAt))} – ${project.completedAt ? year.format(new Date(project.completedAt)) : m.portfolio_present({}, options)}`
  : undefined;

Astro.response.headers.set("vary", "accept");
---

<DocumentArticle
  document={project}
  section="portfolio"
  path={path}
  sectionPath={portfolioPath}
  sectionName={m.portfolio_title({}, options)}
  coverClass="aspect-[16/10]"
  jsonLd={graph(
    locale,
    projectNode(project, path),
    breadcrumbNode([
      { name: m.portfolio_title({}, options), path: portfolioPath },
      { name: project.title, path },
    ])
  )}
>
  {
    project.featured && (
      <p slot="runhead" class="o-feat mb-3">
        {m.portfolio_featured({}, options)}
      </p>
    )
  }
  {
    timeline && (
      <li slot="meta">
        <b>{timeline}</b>
      </li>
    )
  }
  {
    (project.websiteUrl || project.repositoryUrl) && (
      <div slot="actions" class="mt-6 flex flex-wrap gap-4">
        {project.websiteUrl && (
          <a
            href={project.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="o-btn o-btn-primary"
            data-magnet
          >
            {m.portfolio_visit({}, options)}
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M4 12 L 12 4 M 6 4 H 12 V 10"
                fill="none"
                stroke="currentColor"
              />
            </svg>
          </a>
        )}
        {project.repositoryUrl && (
          <a
            href={project.repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="o-btn"
            data-magnet
          >
            {m.portfolio_source({}, options)}
          </a>
        )}
      </div>
    )
  }
</DocumentArticle>
