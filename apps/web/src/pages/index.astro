---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";

import IndexHead from "@/modules/blog/IndexHead.astro";
import PostEntry from "@/modules/blog/PostEntry.astro";
import { listPosts } from "@/modules/blog/blog.data.ts";
import Derive from "@/modules/home/Derive.astro";
import Hero from "@/modules/home/Hero.astro";
import Inside from "@/modules/home/Inside.astro";
import Stack from "@/modules/home/Stack.astro";
import { loadSite } from "@/modules/home/site.server.ts";
import ProjectCard from "@/modules/portfolio/ProjectCard.astro";
import { listProjects } from "@/modules/portfolio/portfolio.data.ts";
import SectionHead from "@/shared/components/SectionHead.astro";
import BaseLayout from "@/shared/layouts/BaseLayout.astro";
import { cachePage } from "@/shared/lib/cache.ts";
import { pageAlternates } from "@/shared/lib/i18n.ts";
import { graph } from "@/shared/seo/json-ld.ts";
import { owner } from "@/shared/site.ts";

const { locale } = Astro.locals;
const options = { locale };

const [posts, projects, site] = await Promise.all([
  listPosts({ limit: 3, locale }),
  listProjects(locale),
  loadSite(locale),
]);
const selectedWork = projects.slice(0, 4);
const [lead, ...rest] = selectedWork;
const indexTag = m.home_index({}, options);
const platesTag = m.home_plates({}, options);
const rfiTag = m.home_rfi({}, options);

cachePage(Astro, "posts", "projects", "site");
---

<BaseLayout
  title={m.home_title({}, options)}
  description={m.home_description({}, options)}
  alternates={pageAlternates("/")}
  jsonLd={graph(locale)}
  sheet="G-001"
  sheetName={m.sheet_cover({}, options)}
>
  <Hero content={site.hero} sourceUrl={site.derive.url} />

  <Stack content={site.stack} />

  <Inside content={site.inside} />

  {
    posts.items.length > 0 && (
      <section
        id="writing"
        aria-labelledby="latest-posts"
        class="o-wrap o-sec"
        data-reveal
        data-section-title={`§3 · ${indexTag}`}
      >
        <SectionHead
          number={3}
          tag={indexTag}
          kicker={m.nav_blog({}, options)}
          id="latest-posts"
          title={m.home_latest_posts({}, options)}
          action={{
            href: localizeHref("/blog", options),
            label: m.home_view_all_posts({}, options),
          }}
        />
        <div class="mt-7">
          <IndexHead />
          <ol class="o-index">
            {posts.items.map((post, index) => (
              <PostEntry post={post} headingLevel={3} latest={index === 0} />
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    lead && (
      <section
        id="work"
        aria-labelledby="selected-work"
        class="o-wrap o-sec"
        data-reveal
        data-section-title={`§4 · ${platesTag}`}
      >
        <SectionHead
          number={4}
          tag={platesTag}
          kicker={m.nav_portfolio({}, options)}
          id="selected-work"
          title={m.home_featured_projects({}, options)}
          action={{
            href: localizeHref("/portfolio", options),
            label: m.home_view_all_projects({}, options),
          }}
        />
        <div class="o-plates">
          <ProjectCard project={lead} decorative />
          <div class="o-feat-copy">
            {lead.featured && (
              <span class="o-feat">{m.portfolio_featured({}, options)}</span>
            )}
            <h3>
              <a href={localizeHref(`/portfolio/${lead.slug}`, options)}>
                {lead.title}
              </a>
            </h3>
            <p>{lead.summary}</p>
            {lead.tags.length > 0 && (
              <ul class="o-tags mb-5" aria-label={m.blog_tags({}, options)}>
                {lead.tags.map((tag) => (
                  <li class="o-tag">{tag.name}</li>
                ))}
              </ul>
            )}
            <div class="flex flex-wrap gap-4">
              <a
                href={localizeHref(`/portfolio/${lead.slug}`, options)}
                class="o-btn o-btn-primary"
                data-magnet
              >
                {m.portfolio_details({}, options)}
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M2 8 H 13 M 9 4 L 13 8 L 9 12"
                    fill="none"
                    stroke="currentColor"
                  />
                </svg>
              </a>
              {lead.websiteUrl && (
                <a
                  href={lead.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="o-btn"
                  data-magnet
                >
                  {m.portfolio_visit({}, options)}
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M4 12 L 12 4 M 6 4 H 12 V 10"
                      fill="none"
                      stroke="currentColor"
                    />
                  </svg>
                </a>
              )}
              {lead.repositoryUrl && (
                <a
                  href={lead.repositoryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="o-btn"
                  data-magnet
                >
                  {m.portfolio_source({}, options)}
                </a>
              )}
            </div>
          </div>
          {rest.map((project) => (
            <ProjectCard project={project} headingLevel={3} />
          ))}
        </div>
      </section>
    )
  }

  <Derive content={site.derive} />

  <section
    id="contact"
    aria-labelledby="contact-teaser"
    class="o-wrap o-sec"
    data-reveal
    data-section-title={`§6 · ${rfiTag}`}
  >
    <SectionHead
      number={6}
      tag={rfiTag}
      kicker={m.contact_title({}, options)}
      id="contact-teaser"
      title={m.sheet_rfi({}, options)}
    />
    <div class="mt-7 grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <p class="o-lead">{m.contact_description({}, options)}</p>
      <div class="o-rfi">
        <dl class="o-rfi-head">
          <div>
            <dt>{m.tb_drawing({}, options)}</dt>
            <dd>G-004</dd>
          </div>
          <div>
            <dt>{m.tb_title({}, options)}</dt>
            <dd>{m.contact_title({}, options)}</dd>
          </div>
          <div>
            <dt>{m.tb_drawn({}, options)}</dt>
            <dd>{owner.name}</dd>
          </div>
        </dl>
        <div class="o-rfi-foot pt-5.5">
          <p>{m.home_rfi_note({}, options)}</p>
          <a
            href={localizeHref("/contact", options)}
            class="o-btn o-btn-primary"
            data-magnet
          >
            {site.hero.contactCta}
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M2 8 H 13 M 9 4 L 13 8 L 9 12"
                fill="none"
                stroke="currentColor"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
