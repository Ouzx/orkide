---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";

import PostCard from "@/modules/blog/PostCard.astro";
import { listPosts } from "@/modules/blog/blog.data.ts";
import Hero from "@/modules/home/Hero.astro";
import ProjectCard from "@/modules/portfolio/ProjectCard.astro";
import { listProjects } from "@/modules/portfolio/portfolio.data.ts";
import SectionHeading from "@/shared/components/SectionHeading.astro";
import BaseLayout from "@/shared/layouts/BaseLayout.astro";
import { cachePage } from "@/shared/lib/cache.ts";
import { getFlags } from "@/shared/lib/flags.ts";
import { pageAlternates } from "@/shared/lib/i18n.ts";
import MediaSlot from "@/shared/media/MediaSlot.astro";
import { graph } from "@/shared/seo/json-ld.ts";

const { locale } = Astro.locals;
const options = { locale };

const [posts, projects, flags] = await Promise.all([
  listPosts({ limit: 3, locale }),
  listProjects(locale),
  getFlags(),
]);
const selectedWork = projects.slice(0, 4);

cachePage(Astro, "posts", "projects");
---

<BaseLayout
  title={m.home_title({}, options)}
  description={m.home_description({}, options)}
  alternates={pageAlternates("/")}
  jsonLd={graph(locale)}
>
  <Hero sceneEnabled={flags["hero-scene"]} />

  {
    posts.items.length > 0 && (
      <section
        aria-labelledby="latest-posts"
        class="mx-auto max-w-6xl px-4 pt-24 sm:px-6"
      >
        <SectionHeading
          id="latest-posts"
          title={m.home_latest_posts({}, options)}
          action={{
            href: localizeHref("/blog", options),
            label: m.home_view_all_posts({}, options),
          }}
        />
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.items.map((post) => (
            <PostCard post={post} headingLevel={3} />
          ))}
        </div>
      </section>
    )
  }

  <section
    aria-labelledby="selected-work"
    class="mx-auto max-w-6xl px-4 pt-24 sm:px-6"
  >
    <SectionHeading
      id="selected-work"
      title={m.home_featured_projects({}, options)}
      action={{
        href: localizeHref("/portfolio", options),
        label: m.home_view_all_projects({}, options),
      }}
    />
    <div class="mb-6 reveal overflow-hidden rounded-2xl border glass">
      <MediaSlot
        id="home-work-loop"
        sizes="(min-width: 1152px) 1104px, 100vw"
      />
    </div>
    {
      selectedWork.length > 0 && (
        <div class="grid gap-6 md:grid-cols-2">
          {selectedWork.map((project) => (
            <ProjectCard project={project} headingLevel={3} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
