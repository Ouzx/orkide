---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";
import { env } from "cloudflare:workers";

import { ContactForm } from "@/modules/contact/contact-form.tsx";
import { contactLabels } from "@/modules/contact/labels.ts";
import PageHeader from "@/shared/components/PageHeader.astro";
import BaseLayout from "@/shared/layouts/BaseLayout.astro";
import { cachePage } from "@/shared/lib/cache.ts";
import { getFlags } from "@/shared/lib/flags.ts";
import { pageAlternates } from "@/shared/lib/i18n.ts";
import { breadcrumbNode, graph } from "@/shared/seo/json-ld.ts";

const { locale } = Astro.locals;
const options = { locale };
const flags = await getFlags();
cachePage(Astro);
---

<BaseLayout
  title={m.contact_title({}, options)}
  description={m.contact_description({}, options)}
  alternates={pageAlternates("/contact")}
  jsonLd={graph(
    locale,
    breadcrumbNode([
      {
        name: m.contact_title({}, options),
        path: localizeHref("/contact", options),
      },
    ])
  )}
>
  <PageHeader
    section={3}
    name={m.contact_title({}, options)}
    title={m.contact_title({}, options)}
    lead={m.contact_description({}, options)}
  />
  <div class="o-wrap pt-10 pb-24 md:pb-32">
    <div class="o-panel max-w-3xl">
      <span class="o-screw o-screw-tl" aria-hidden="true"></span>
      <span class="o-screw o-screw-tr" aria-hidden="true"></span>
      {
        flags["contact-form"] ? (
          <ContactForm
            client:visible
            locale={locale}
            siteKey={env.TURNSTILE_SITE_KEY}
            labels={contactLabels(locale)}
          />
        ) : (
          <div>
            <div class="o-status">
              <span class="o-lamp" data-tone="warn" aria-hidden="true" />
              <span class="o-mini" aria-hidden="true">
                {m.contact_offline({}, options)}
              </span>
            </div>
            <p role="status" class="m-0 text-ink-2">
              {m.contact_disabled({}, options)}
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
