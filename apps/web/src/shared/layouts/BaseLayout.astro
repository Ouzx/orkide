---
import { m } from "@orkide/i18n/messages";
import { getTextDirection } from "@orkide/i18n/runtime";
import "@orkide/ui/globals.css";
import { tokens } from "@orkide/ui/tokens/tokens";
import { Font } from "astro:assets";

import SheetFrame from "@/shared/components/SheetFrame.astro";
import SiteFooter from "@/shared/components/SiteFooter.astro";
import SiteHeader from "@/shared/components/SiteHeader.astro";
import { languageTag } from "@/shared/lib/i18n.ts";
import Seo from "@/shared/seo/Seo.astro";
import type { Props as SeoProps } from "@/shared/seo/Seo.astro";
import ThemeScript from "@/shared/theme/ThemeScript.astro";

type Props = SeoProps & {
  /** This page's drawing number: in the title strip, the status line and the title block. */
  sheet?: string;
  /** This page's name in the title block and the status line (defaults to its title). */
  sheetName?: string;
};

const { sheet = "G-001", sheetName, ...seo } = Astro.props;
const { locale } = Astro.locals;
const name = sheetName ?? seo.title;
---

<!doctype html>
<html
  lang={languageTag[locale]}
  dir={getTextDirection(locale)}
  data-locale={locale}
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <ThemeScript />
    <meta name="theme-color" content={tokens.color.blue.paper} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Font
      cssVariable="--font-archivo"
      preload={[{ style: "normal", subset: "latin" }]}
    />
    <Font cssVariable="--font-chivo-mono" />
    <Font cssVariable="--font-shantell" />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="o-btn o-btn-primary sr-only z-(--o-z-float) focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:px-5"
    >
      {m.a11y_skip_to_content({}, { locale })}
    </a>
    <SheetFrame sheet={sheet} name={name} />
    <SiteHeader alternates={Astro.props.alternates} sheet={sheet} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <SiteFooter sheet={sheet} name={name} />
    <script>
      import { startBeacon } from "@/shared/analytics/beacon.ts";
      import { joinPresence } from "@/shared/analytics/presence.ts";
      import {
        afterFirstPaint,
        motionAllowed,
      } from "@/shared/motion/motion.ts";

      joinPresence();

      // The skin's motion arrives after first paint, and only for visitors who allow it. Turning
      // it off later reloads the page into its resting state.
      let moving = false;
      const move = () => {
        if (motionAllowed() && !moving) {
          moving = true;
          void import("@/shared/motion/blueprint.ts");
        }
      };
      afterFirstPaint(move);
      document.addEventListener("motionchange", () => {
        if (moving && !motionAllowed()) {
          location.reload();
        } else {
          move();
        }
      });

      // Rendered by the server from the request locale; the API validates it again.
      const { locale } = document.documentElement.dataset;
      if (locale) {
        startBeacon(locale);
      }
    </script>
  </body>
</html>
