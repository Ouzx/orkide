---
import { m } from "@orkide/i18n/messages";
import { getTextDirection } from "@orkide/i18n/runtime";
import "@orkide/ui/globals.css";
import { Font } from "astro:assets";

import SiteFooter from "@/shared/components/SiteFooter.astro";
import SiteHeader from "@/shared/components/SiteHeader.astro";
import { languageTag } from "@/shared/lib/i18n.ts";
import Seo from "@/shared/seo/Seo.astro";
import type { Props as SeoProps } from "@/shared/seo/Seo.astro";
import ThemeScript from "@/shared/theme/ThemeScript.astro";

type Props = SeoProps & {
  /**
   * Also preload the label and mono faces, for pages whose first screen is spec lists. Their
   * metric-matched fallbacks need Arial and Courier New, which Linux and Android lack, so the
   * lists would shift when the fonts arrive. Off elsewhere: the extra preloads delay the LCP.
   */
  preloadSpecFonts?: boolean;
};

const { preloadSpecFonts = false, ...seo } = Astro.props;
const { locale } = Astro.locals;
const specPreload = preloadSpecFonts
  ? [{ style: "normal", subset: "latin" } as const]
  : undefined;
---

<!doctype html>
<html
  lang={languageTag[locale]}
  dir={getTextDirection(locale)}
  data-locale={locale}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <meta
      name="theme-color"
      content="#e7e3d9"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#26272a"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Font
      cssVariable="--font-hanken"
      preload={[{ style: "normal", subset: "latin" }]}
    />
    <Font cssVariable="--font-saira" preload={specPreload} />
    <Font
      cssVariable="--font-doto"
      preload={[{ style: "normal", subset: "latin" }]}
    />
    <Font cssVariable="--font-martian" preload={specPreload} />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="o-key o-key-signal sr-only z-50 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {m.a11y_skip_to_content({}, { locale })}
    </a>
    <SiteHeader alternates={Astro.props.alternates} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { startBeacon } from "@/shared/analytics/beacon.ts";
      import { joinPresence } from "@/shared/analytics/presence.ts";
      import {
        afterFirstPaint,
        motionAllowed,
      } from "@/shared/motion/motion.ts";

      joinPresence();

      // The skin's motion arrives after first paint, and only for visitors who allow it. Turning
      // it off later reloads the page into its resting state.
      let moving = false;
      const move = () => {
        if (motionAllowed() && !moving) {
          moving = true;
          void import("@/shared/motion/instrument.ts");
        }
      };
      afterFirstPaint(move);
      document.addEventListener("motionchange", () => {
        if (moving && !motionAllowed()) {
          location.reload();
        } else {
          move();
        }
      });

      // Rendered by the server from the request locale; the API validates it again.
      const { locale } = document.documentElement.dataset;
      if (locale) {
        startBeacon(locale);
      }
    </script>
  </body>
</html>
