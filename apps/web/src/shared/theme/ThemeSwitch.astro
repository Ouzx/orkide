---
import { m } from "@orkide/i18n/messages";

const { locale } = Astro.locals;
const options = { locale };
---

<!--
  The print: blue (the default) or white. A double-throw switch whose blade points at the print in
  use; checked means the white print. The change is exposed by a lamp sweeping across the sheet.
-->
<button
  type="button"
  class="o-switch"
  role="switch"
  aria-checked="false"
  aria-label={m.theme_switch({}, options)}
  data-throws="2"
  data-print-switch
>
  <svg viewBox="0 0 46 26" aria-hidden="true">
    <circle data-part="contact" cx="6" cy="13" r="2.6"></circle>
    <line x1="40" y1="3.5" x2="46" y2="3.5"></line>
    <line x1="40" y1="22.5" x2="46" y2="22.5"></line>
    <circle data-part="contact" cx="38" cy="3.5" r="2.2"></circle>
    <circle data-part="contact" cx="38" cy="22.5" r="2.2"></circle>
    <line data-part="blade" x1="6" y1="13" x2="36" y2="13"></line>
  </svg>
  <span class="o-switch-names" aria-hidden="true">
    <span data-print="blue" data-on>{m.theme_blue({}, options)}</span>
    <span data-print="white">{m.theme_white({}, options)}</span>
  </span>
</button>

<script>
  import { motionAllowed } from "@/shared/motion/motion.ts";

  import { readWhite, storeWhite } from "./theme.ts";

  const switches = [
    ...document.querySelectorAll<HTMLElement>("[data-print-switch]"),
  ];
  const show = (white: boolean) => {
    for (const button of switches) {
      button.setAttribute("aria-checked", String(white));
      for (const name of button.querySelectorAll<HTMLElement>("[data-print]")) {
        name.toggleAttribute(
          "data-on",
          (name.dataset.print === "white") === white
        );
      }
    }
  };
  show(readWhite());

  for (const button of switches) {
    button.addEventListener("click", async () => {
      // From the page, not storage: storage can be blocked, the class is always there.
      const white = !document.documentElement.classList.contains("light");
      const apply = () => {
        storeWhite(white);
        show(white);
      };
      const lamp = document.querySelector<HTMLElement>("[data-lamp]");
      if (!("startViewTransition" in document && lamp && motionAllowed())) {
        apply();
        return;
      }
      // The lamp is captured at the left edge, then at the right: the transition moves it across
      // while the new print is exposed behind it (styles/motion.css).
      const root = document.documentElement;
      root.classList.add("o-exposing");
      lamp.toggleAttribute("data-on", true);
      const transition = document.startViewTransition(() => {
        apply();
        lamp.toggleAttribute("data-end", true);
      });
      try {
        await transition.finished;
      } finally {
        root.classList.remove("o-exposing");
        delete lamp.dataset.on;
        delete lamp.dataset.end;
      }
    });
  }
</script>
