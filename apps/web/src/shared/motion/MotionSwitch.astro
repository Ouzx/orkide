---
import { m } from "@orkide/i18n/messages";

const { locale } = Astro.locals;
---

<!--
  Switches the site's motion off and on for this browser (pressed = reduced): a single-throw
  switch, closed while motion runs. Hidden for visitors whose system already asks for reduced
  motion: the site follows that setting anyway.
-->
<button
  type="button"
  class="o-switch motion-reduce:hidden"
  aria-pressed="false"
  data-throws="1"
  data-motion-switch
>
  <svg viewBox="0 0 46 26" aria-hidden="true">
    <circle data-part="contact" cx="6" cy="13" r="2.6"></circle>
    <circle data-part="contact" cx="38" cy="13" r="2.6"></circle>
    <line x1="41" y1="13" x2="46" y2="13"></line>
    <line data-part="blade" x1="6" y1="13" x2="36" y2="13"></line>
  </svg>
  <span>{m.motion_reduce({}, { locale })}</span>
</button>

<script>
  import { storeCalm } from "./motion.ts";

  const html = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-motion-switch]"
  )) {
    button.setAttribute(
      "aria-pressed",
      String(html.classList.contains("calm"))
    );
    button.addEventListener("click", () => {
      const calm = !html.classList.contains("calm");
      storeCalm(calm);
      button.setAttribute("aria-pressed", String(calm));
    });
  }
</script>
