---
import { m } from "@orkide/i18n/messages";

const { locale } = Astro.locals;
---

<!--
  Switches the site's motion off and on for this browser (pressed = reduced). Hidden for visitors
  whose system already asks for reduced motion: the site follows that setting anyway.
-->
<button
  type="button"
  class="o-switch o-switch-inline motion-reduce:hidden"
  aria-pressed="false"
  data-motion-switch
>
  <span class="o-slot" aria-hidden="true"><span class="o-thumb"></span></span>
  <span class="o-eng">{m.motion_reduce({}, { locale })}</span>
</button>

<script>
  import { storeCalm } from "./motion.ts";

  const html = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-motion-switch]"
  )) {
    button.setAttribute(
      "aria-pressed",
      String(html.classList.contains("calm"))
    );
    button.addEventListener("click", () => {
      const calm = !html.classList.contains("calm");
      storeCalm(calm);
      button.setAttribute("aria-pressed", String(calm));
    });
  }
</script>
