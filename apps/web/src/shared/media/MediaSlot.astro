---
import { m } from "@orkide/i18n/messages";

import { mediaSlots } from "./slots.ts";
import type { MediaSlot, MediaSlotId } from "./slots.ts";

interface Props {
  id: MediaSlotId;
  class?: string;
  /** Above-the-fold media is fetched eagerly with high priority (LCP candidate). */
  priority?: boolean;
  /** Accessible text for non-decorative media. */
  alt?: string;
  /** Hide the placeholder's caption (for slots used as a backdrop). */
  bare?: boolean;
}

const { id, class: className, priority = false, alt = "", bare = false } = Astro.props;
const slot: MediaSlot = mediaSlots[id];
const { locale } = Astro.locals;
---

{
  slot.src && slot.kind === "image" ? (
    <img
      src={slot.src}
      width={slot.width}
      height={slot.height}
      alt={slot.decorative ? "" : alt}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
      class:list={["h-auto w-full object-cover", slot.aspect, className]}
    />
  ) : slot.src ? (
    <video
      src={slot.src}
      poster={slot.poster}
      width={slot.width}
      height={slot.height}
      autoplay
      muted
      loop
      playsinline
      preload={priority ? "auto" : "none"}
      aria-hidden={slot.decorative ? "true" : undefined}
      aria-label={slot.decorative ? undefined : alt}
      class:list={["h-auto w-full object-cover motion-reduce:hidden", slot.aspect, className]}
    />
  ) : (
    <div
      role={slot.decorative ? undefined : "img"}
      aria-hidden={slot.decorative ? "true" : undefined}
      aria-label={slot.decorative ? undefined : m.media_placeholder({ id }, { locale })}
      data-media-slot={id}
      class:list={[
        "bg-card relative isolate w-full overflow-hidden rounded-[inherit]",
        slot.aspect,
        className,
      ]}
    >
      <div class="bg-grid absolute inset-0 opacity-60 [mask-image:radial-gradient(ellipse_at_center,black,transparent_75%)]" />
      <div class="bg-orchid/25 absolute -top-1/4 -left-1/4 size-3/4 rounded-full blur-3xl" />
      <div class="bg-aurora/20 absolute -right-1/4 -bottom-1/4 size-3/4 rounded-full blur-3xl" />
      <div class:list={["text-muted-foreground absolute inset-x-0 bottom-0 flex items-center justify-between gap-4 p-4 font-mono text-xs tracking-widest uppercase", bare && "hidden"]} lang="en">
        <span>media · {id}</span>
        <span>
          {slot.kind} · {slot.width}×{slot.height}
        </span>
      </div>
    </div>
  )
}
