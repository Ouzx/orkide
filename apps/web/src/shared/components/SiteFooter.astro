---
import { m } from "@orkide/i18n/messages";

import MotionSwitch from "@/shared/motion/MotionSwitch.astro";
import { owner } from "@/shared/site.ts";

const { locale } = Astro.locals;
const options = { locale };
const feeds = [
  { href: `/${locale}/rss.xml`, label: "RSS" },
  { href: `/${locale}/atom.xml`, label: "Atom" },
  { href: `/${locale}/feed.json`, label: "JSON Feed" },
];
const agents = [
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/sitemap.xml", label: "Sitemap" },
  { href: "/api/docs", label: "API" },
];
---

<!-- The device's back panel: serial label, the motion switch, and the ports (feeds, agents). -->
<footer class="o-back">
  <div
    class="o-wrap grid gap-8 pt-11 pb-16 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr]"
  >
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="o-eng m-0">{m.skin_back_panel({}, options)}</p>
      <div class="o-serial mt-4">
        <b>{m.site_name({}, options)} · {m.skin_model({}, options)}</b>
        <span>
          {
            m.footer_copyright(
              { name: owner.name, year: new Date().getFullYear().toString() },
              options
            )
          }
        </span>
        <span>{m.footer_built_with({}, options)}</span>
        <span>
          {m.skin_serial({ build: import.meta.env.PUBLIC_BUILD }, options)}
        </span>
      </div>
      <div class="mt-4">
        <MotionSwitch />
      </div>
    </div>
    <nav aria-labelledby="footer-feeds">
      <h2 id="footer-feeds" class="o-eng m-0">
        {m.footer_feeds({}, options)}
      </h2>
      <ul class="o-jacks">
        {
          feeds.map((feed) => (
            <li>
              <a class="o-jack" href={feed.href} data-astro-prefetch="false">
                <i aria-hidden="true" />
                <span>{feed.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-labelledby="footer-agents">
      <h2 id="footer-agents" class="o-eng m-0">
        {m.footer_for_agents({}, options)}
      </h2>
      <ul class="o-jacks">
        {
          agents.map((link) => (
            <li>
              <a class="o-jack" href={link.href} data-astro-prefetch="false">
                <i aria-hidden="true" />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
