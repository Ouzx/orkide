---
import { m } from "@orkide/i18n/messages";

import Picture from "@/shared/media/Picture.astro";
import { owner } from "@/shared/site.ts";

import Logo from "./Logo.astro";

const { locale } = Astro.locals;
const options = { locale };
const feeds = [
  { href: `/${locale}/rss.xml`, label: "RSS" },
  { href: `/${locale}/atom.xml`, label: "Atom" },
  { href: `/${locale}/feed.json`, label: "JSON Feed" },
];
const agents = [
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/sitemap.xml", label: "Sitemap" },
  { href: "/api/docs", label: "API" },
];
---

<footer class="mt-24 border-t glass">
  <div
    class="mx-auto grid max-w-6xl gap-8 px-4 py-12 text-sm text-muted-foreground sm:grid-cols-[1fr_auto_auto] sm:px-6"
  >
    <div class="group flex items-start gap-4">
      <Picture
        id="portrait"
        sizes="48px"
        class="size-12 shrink-0 rounded-full border"
      />
      <div class="space-y-2">
        <p class="font-medium text-foreground">
          {
            m.footer_copyright(
              { name: owner.name, year: new Date().getFullYear().toString() },
              options
            )
          }
        </p>
        <p class="flex items-center gap-2">
          <Logo class="size-5" weight={44} />
          {m.footer_built_with({}, options)}
        </p>
      </div>
    </div>
    <nav aria-labelledby="footer-feeds">
      <h2 id="footer-feeds" class="mb-3 font-medium text-foreground">
        {m.footer_feeds({}, options)}
      </h2>
      <ul class="space-y-2">
        {
          feeds.map((feed) => (
            <li>
              <a
                class="link-draw transition-colors hover:text-foreground"
                href={feed.href}
                data-astro-prefetch="false"
              >
                {feed.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-labelledby="footer-agents">
      <h2 id="footer-agents" class="mb-3 font-medium text-foreground">
        {m.footer_for_agents({}, options)}
      </h2>
      <ul class="space-y-2">
        {
          agents.map((link) => (
            <li>
              <a
                class="link-draw transition-colors hover:text-foreground"
                href={link.href}
                data-astro-prefetch="false"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
