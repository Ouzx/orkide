---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";

import MotionSwitch from "@/shared/motion/MotionSwitch.astro";
import { owner } from "@/shared/site.ts";

interface Props {
  /** This page's drawing number and name, for the title block. */
  sheet: string;
  name: string;
}

const { sheet, name } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
const site = m.site_name({}, options);
const build = import.meta.env.PUBLIC_BUILD;
const revisions = import.meta.env.PUBLIC_REVISIONS;
const date = revisions[0]?.date ?? "";
const pages = [
  { href: localizeHref("/blog", options), label: m.nav_blog({}, options) },
  {
    href: localizeHref("/portfolio", options),
    label: m.nav_portfolio({}, options),
  },
  { href: localizeHref("/atlas", options), label: m.nav_atlas({}, options) },
  {
    href: localizeHref("/contact", options),
    label: m.nav_contact({}, options),
  },
];
const feeds = [
  { href: `/${locale}/rss.xml`, label: "RSS" },
  { href: `/${locale}/atom.xml`, label: "Atom" },
  { href: `/${locale}/feed.json`, label: "JSON Feed" },
];
const agents = [
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/atlas.json", label: "atlas.json" },
  { href: "/sitemap.xml", label: "Sitemap" },
  { href: "/api/docs", label: "API" },
];
const groups = [
  { id: "footer-pages", label: m.footer_pages({}, options), links: pages },
  { id: "footer-feeds", label: m.footer_feeds({}, options), links: feeds },
  {
    id: "footer-agents",
    label: m.footer_for_agents({}, options),
    links: agents,
  },
];
---

<!-- The title block: what this sheet is, who drew it, and the revisions it went through. -->
<footer class="o-tb o-wrap">
  <div class="o-tb-grid">
    <div>
      <p class="o-wordmark" aria-hidden="true">
        {[...site].map((letter) => <span>{letter}</span>)}
      </p>
      <p class="mt-4 mb-0 max-w-[28em] text-sm text-ink-2">
        {m.footer_about({}, options)}
      </p>
      <div class="o-tb-links">
        {
          groups.map((group) => (
            <nav aria-labelledby={group.id}>
              <h2 id={group.id} class="o-label">
                {group.label}
              </h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a
                      class="o-link"
                      href={link.href}
                      data-astro-prefetch="false"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>
    <dl class="o-block">
      <div data-w="4" data-big>
        <dt>{m.tb_project({}, options)}</dt>
        <dd>{site}</dd>
      </div>
      <div data-w="2" data-big data-accent>
        <dt>{m.tb_drawing({}, options)}</dt>
        <dd>{sheet}</dd>
      </div>
      <div data-w="4">
        <dt>{m.tb_title({}, options)}</dt>
        <dd>{name}</dd>
      </div>
      <div data-w="2" data-accent>
        <dt>{m.tb_revision({}, options)}</dt>
        <dd>{build}</dd>
      </div>
      <div data-w="2">
        <dt>{m.tb_scale({}, options)}</dt>
        <dd>1 : 1</dd>
      </div>
      <div data-w="2">
        <dt>{m.tb_drawn({}, options)}</dt>
        <dd>{owner.name}</dd>
      </div>
      <div data-w="2">
        <dt>{m.tb_date({}, options)}</dt>
        <dd>{date}</dd>
      </div>
      {
        revisions.length > 0 && (
          <div class="o-rev">
            <dt class="sr-only">{m.tb_revisions({}, options)}</dt>
            <dd class="m-0">
              <table>
                <thead>
                  <tr>
                    <th scope="col">{m.tb_revision({}, options)}</th>
                    <th scope="col">{m.tb_date({}, options)}</th>
                    <th scope="col">{m.tb_change({}, options)}</th>
                  </tr>
                </thead>
                <tbody>
                  {revisions.map((revision) => (
                    <tr>
                      <td>{revision.hash}</td>
                      <td>{revision.date}</td>
                      <td>{revision.subject}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </dd>
          </div>
        )
      }
    </dl>
  </div>
  <div class="o-tb-base">
    <span>
      {
        m.footer_copyright(
          { name: owner.name, year: new Date().getFullYear().toString() },
          options
        )
      } · {m.footer_built_with({}, options)}
    </span>
    <MotionSwitch />
  </div>
</footer>
