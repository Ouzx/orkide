---
import { meters } from "@orkide/ui/effects/meters";

/** A gauge fixed to the corner of a manual page: its needle follows reading progress. */
const { majorEvery, sweep, ticks } = meters.dial;
const lines = Array.from({ length: ticks }, (_, index) => {
  const angle = ((-sweep / 2 + (index * sweep) / (ticks - 1)) * Math.PI) / 180;
  const major = index % majorEvery === 0;
  const inner = major ? 27 : 31;
  return {
    width: major ? 2 : 1,
    x1: 38 + Math.sin(angle) * inner,
    x2: 38 + Math.sin(angle) * 35,
    y1: 38 - Math.cos(angle) * inner,
    y2: 38 - Math.cos(angle) * 35,
  };
});
---

<div class="o-dial" aria-hidden="true" hidden data-reading-dial>
  <svg viewBox="0 0 76 76">
    {
      lines.map((line) => (
        <line
          x1={line.x1.toFixed(2)}
          y1={line.y1.toFixed(2)}
          x2={line.x2.toFixed(2)}
          y2={line.y2.toFixed(2)}
          stroke-width={line.width}
        />
      ))
    }
    <g data-needle><line x1="38" y1="38" x2="38" y2="10"></line></g>
    <circle cx="38" cy="38" r="5"></circle>
  </svg>
  <b data-reading-value>0%</b>
</div>

<script>
  import { meters } from "@orkide/ui/effects/meters";

  // Reading progress of the article around the dial; shown only when this script runs.
  const dial = document.querySelector<HTMLElement>("[data-reading-dial]");
  const article = dial?.closest("article");
  const needle = dial?.querySelector<SVGGElement>("[data-needle]");
  const value = dial?.querySelector("[data-reading-value]");
  if (dial && article && needle && value) {
    dial.hidden = false;
    let frame = 0;
    const paint = () => {
      frame = 0;
      const box = article.getBoundingClientRect();
      const progress = Math.min(
        1,
        Math.max(0, -box.top / Math.max(1, box.height - innerHeight))
      );
      const { sweep } = meters.dial;
      needle.style.transform = `rotate(${-sweep / 2 + progress * sweep}deg)`;
      value.textContent = `${Math.round(progress * 100)}%`;
    };
    addEventListener(
      "scroll",
      () => {
        frame ||= requestAnimationFrame(paint);
      },
      { passive: true }
    );
    paint();
  }
</script>
