---
import { locales } from "@orkide/i18n";
import { m } from "@orkide/i18n/messages";
import { cookieMaxAge, cookieName, localizeHref } from "@orkide/i18n/runtime";

import { localeName } from "@/shared/lib/i18n.ts";
import type { Alternates } from "@/shared/lib/i18n.ts";

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;
const { locale } = Astro.locals;
---

<!-- A two-position slide switch whose positions are the alternate links (no JavaScript needed). -->
<nav
  aria-label={m.locale_label({}, { locale })}
  class="o-switch"
  data-position={locales.indexOf(locale)}
  data-locale-cookie={cookieName}
  data-locale-cookie-max-age={cookieMaxAge}
>
  <ul class="o-slot m-0 list-none p-0">
    {
      locales.map((target, index) => (
        <li>
          <a
            href={alternates[target] ?? localizeHref("/", { locale: target })}
            hreflang={target}
            lang={target}
            title={localeName(target)}
            aria-current={target === locale ? "true" : undefined}
            data-locale-link={target}
            data-astro-prefetch="false"
            class="o-hit"
            data-side={index === 0 ? "start" : "end"}
          >
            <span class="sr-only">{localeName(target)}</span>
          </a>
        </li>
      ))
    }
    <li aria-hidden="true" class="o-thumb"></li>
  </ul>
  <span class="o-eng" aria-hidden="true">
    {locales.map((code) => code.toUpperCase()).join(" · ")}
  </span>
</nav>

<script>
  // Remember the choice, so the next visit to an unprefixed URL lands in the same language.
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>(
      "[data-locale-link]"
    );
    const locale = link?.dataset.localeLink;
    // Cookie settings come from the server-rendered markup: the Paraglide runtime stays off the client.
    const settings = link?.closest<HTMLElement>(
      "[data-locale-cookie]"
    )?.dataset;
    if (locale && settings?.localeCookie) {
      void globalThis.cookieStore?.set({
        expires: Date.now() + Number(settings.localeCookieMaxAge) * 1000,
        name: settings.localeCookie,
        path: "/",
        sameSite: "lax",
        value: locale,
      });
    }
  });
</script>
