---
import { m } from "@orkide/i18n/messages";

interface Props {
  /** The manual section this page belongs to: 1 Blog, 2 Portfolio, 3 Contact. */
  section: number;
  /** The section's name, for the running head. */
  name: string;
  title: string;
  lead?: string | undefined;
}
const { section, name, title, lead } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
---

<header class="o-wrap pt-9">
  <div class="o-runhead">
    <span class="o-eng">
      {
        `${m.skin_manual({ site: m.site_name({}, options) }, options)} · §${section} ${name}`
      }
    </span>
    <span class="o-eng">
      {m.skin_page({ n: section.toString().padStart(2, "0") }, options)}
    </span>
  </div>
  <div class="mt-8 grid gap-5">
    <h1 class="o-page-title">{title}</h1>
    {lead && <p class="o-summary text-ink-2">{lead}</p>}
    <slot />
  </div>
</header>
