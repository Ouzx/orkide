---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";

interface Props {
  /** This page's drawing number (G-002 the drawing index, G-003 the plates, G-004 contact). */
  sheet: string;
  /** What kind of sheet it is, for the drawing block and the crumbs. */
  kind: string;
  title: string;
  lead?: string | undefined;
}
const { sheet, kind, title, lead } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
---

<!-- A sheet's header: crumbs back to the cover, its drawing block, its title. -->
<header class="o-wrap" data-section-title={`${sheet} · ${kind}`}>
  <ol class="o-crumbs">
    <li>
      <a href={localizeHref("/", options)}>G-001 {m.sheet_cover({}, options)}</a
      >
    </li>
    <li aria-current="page">{sheet}</li>
  </ol>
  <div class="o-pagehead">
    <dl class="o-dwg">
      <div data-big>
        <dt>{m.doc_drawing({}, options)}</dt>
        <dd>{sheet}</dd>
      </div>
      <div>
        <dt>{m.tb_title({}, options)}</dt>
        <dd>{kind}</dd>
      </div>
      <div>
        <dt>{m.tb_revision({}, options)}</dt>
        <dd>{import.meta.env.PUBLIC_BUILD}</dd>
      </div>
    </dl>
    <div class="o-pagehead-main">
      <h1 class="o-title">{title}</h1>
      {lead && <p class="o-lead">{lead}</p>}
      <slot />
    </div>
  </div>
</header>
