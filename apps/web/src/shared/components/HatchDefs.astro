---
/** The hatch pattern every drawing fills with (`url(#o-hatch)`): defined once per page. */
---

<svg
  class="absolute size-0 overflow-hidden"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern
      id="o-hatch"
      width="7"
      height="7"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line class="o-hatch-line" x1="0" y1="0" x2="0" y2="7"></line>
    </pattern>
  </defs>
</svg>
