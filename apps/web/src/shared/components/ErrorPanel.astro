---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";

interface Props {
  /** The status code: the sheet is X-404, X-500… */
  code: string;
  title: string;
  body: string;
  action: { href: string; label: string };
}

const { code, title, body, action } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };
const sheet = `X-${code}`;
---

<!-- An error page as a sheet stamped void: its drawing block, the stamp, and the way back. -->
<section
  class="o-wrap pb-24 md:pb-32"
  data-section-title={`${sheet} · ${m.sheet_void({}, options)}`}
>
  <ol class="o-crumbs">
    <li><a href={localizeHref("/", options)}>G-001</a></li>
    <li aria-current="page">{sheet}</li>
  </ol>
  <div class="o-pagehead">
    <dl class="o-dwg">
      <div data-big>
        <dt>{m.doc_drawing({}, options)}</dt>
        <dd>{sheet}</dd>
      </div>
      <div>
        <dt>{m.tb_title({}, options)}</dt>
        <dd>{m.sheet_void({}, options)}</dd>
      </div>
      <div>
        <dt>{m.tb_revision({}, options)}</dt>
        <dd>{import.meta.env.PUBLIC_BUILD}</dd>
      </div>
    </dl>
    <div class="o-pagehead-main">
      <span class="o-stamp o-stamp-static mb-7" aria-hidden="true">
        <b>{m.sheet_void({}, options)}</b>
        <small>{code}</small>
      </span>
      <h1 class="o-title">{title}</h1>
      <p class="o-lead mt-4">{body}</p>
      <div class="o-ctas">
        <a href={action.href} class="o-btn o-btn-primary" data-magnet>
          {action.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
