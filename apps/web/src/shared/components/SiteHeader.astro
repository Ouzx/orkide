---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";
import { Menu, X } from "lucide-react";

import type { Alternates } from "@/shared/lib/i18n.ts";
import SoundSwitch from "@/shared/sound/SoundSwitch.astro";
import ThemeSwitch from "@/shared/theme/ThemeSwitch.astro";

import LocaleSwitch from "./LocaleSwitch.astro";

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };

/** De-localized path of the current page (the middleware rewrote the localized URL). */
const path = Astro.url.pathname;
const links = [
  { href: "/blog", label: m.nav_blog({}, options) },
  { href: "/portfolio", label: m.nav_portfolio({}, options) },
  { href: "/contact", label: m.nav_contact({}, options) },
].map((link) => ({
  ...link,
  current: path === link.href || path.startsWith(`${link.href}/`),
  localized: localizeHref(link.href, { locale }),
}));
// The header's screen names the manual section in view: §1 Blog, §2 Portfolio, §3 Contact.
const section = links.findIndex((link) => link.current) + 1;
const readout =
  section > 0
    ? `§${section} ${links[section - 1]?.label ?? ""}`
    : `§0 ${m.skin_panel({}, options)}`;
---

<header class="o-head">
  <div class="o-wrap o-head-row">
    <a
      href={localizeHref("/", { locale })}
      class="o-brand"
      aria-label={`${m.site_name({}, options)} — ${m.nav_home({}, options)}`}
    >
      <b>{m.site_name({}, options)}</b>
      <span aria-hidden="true" class="hidden sm:inline">
        {m.skin_model({}, options)}
      </span>
    </a>

    <nav
      aria-label={m.nav_primary({}, options)}
      class="ml-auto hidden md:block"
    >
      <ul class="flex items-center gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.localized}
                aria-current={link.current ? "page" : undefined}
                class="o-key"
              >
                <span class="o-lamp" aria-hidden="true" />
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="o-mini hidden xl:flex" aria-hidden="true" data-readout>
      {readout}
    </div>

    <div class="ml-auto flex items-center gap-3.5 md:ml-0">
      <ThemeSwitch />
      <SoundSwitch class="hidden sm:inline-grid" />
      <LocaleSwitch alternates={alternates} />
      <button
        type="button"
        popovertarget="mobile-nav"
        class="o-key o-key-icon md:hidden"
      >
        <Menu aria-hidden="true" />
        <span class="sr-only">{m.nav_menu({}, options)}</span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation: native popover (light dismiss, Esc, focus handling) — no JavaScript. -->
  <nav
    id="mobile-nav"
    popover
    aria-label={m.nav_primary({}, options)}
    class="inset-0 m-0 h-dvh w-full max-w-none bg-case text-ink md:hidden"
  >
    <div class="o-wrap flex h-16 items-center justify-between">
      <span class="o-eng">{m.nav_menu({}, options)}</span>
      <button
        type="button"
        popovertarget="mobile-nav"
        popovertargetaction="hide"
        class="o-key o-key-icon"
      >
        <X aria-hidden="true" />
        <span class="sr-only">{m.nav_menu({}, options)}</span>
      </button>
    </div>
    <ul class="o-wrap grid gap-3 pt-6">
      {
        links.map((link, index) => (
          <li>
            <a
              href={link.localized}
              aria-current={link.current ? "page" : undefined}
              class="o-key o-key-lg w-full justify-start"
            >
              <span class="o-lamp" aria-hidden="true" />
              <span class="text-ink-2">§{index + 1}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="o-wrap mt-8 flex items-center gap-4 sm:hidden">
      <SoundSwitch />
    </div>
  </nav>
</header>
