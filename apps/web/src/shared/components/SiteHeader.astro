---
import { m } from "@orkide/i18n/messages";
import { localizeHref } from "@orkide/i18n/runtime";

import BrandMark from "@/shared/components/BrandMark.astro";
import type { Alternates } from "@/shared/lib/i18n.ts";
import ThemeSwitch from "@/shared/theme/ThemeSwitch.astro";

import LocaleSwitch from "./LocaleSwitch.astro";

interface Props {
  alternates: Alternates;
  /** This page's drawing number, beside the wordmark. */
  sheet: string;
}

const { alternates, sheet } = Astro.props;
const { locale } = Astro.locals;
const options = { locale };

/** De-localized path of the current page (the middleware rewrote the localized URL). */
const path = Astro.url.pathname;
const links = [
  { href: "/blog", label: m.nav_blog({}, options) },
  { href: "/portfolio", label: m.nav_portfolio({}, options) },
  { href: "/atlas", label: m.nav_atlas({}, options) },
  { href: "/contact", label: m.nav_contact({}, options) },
].map((link) => ({
  ...link,
  current: path === link.href || path.startsWith(`${link.href}/`),
  localized: localizeHref(link.href, { locale }),
}));
---

<!-- The title strip: the wordmark with this sheet's number, the sections, and the switches. -->
<header class="o-strip">
  <div class="o-wrap o-strip-row">
    <div class="o-grp">
      <a
        href={localizeHref("/", { locale })}
        class="o-brand o-sel"
        aria-label={`${m.site_name({}, options)} — ${m.nav_home({}, options)}`}
      >
        <BrandMark />
        <span class="o-brand-word">{m.site_name({}, options)}</span>
      </a>
      <span class="o-sheetno" aria-hidden="true">{sheet}</span>
    </div>

    <nav aria-label={m.nav_primary({}, options)} class="o-grp hidden md:flex">
      {
        links.map((link) => (
          <a
            href={link.localized}
            aria-current={link.current ? "page" : undefined}
            class="o-nav-link"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="o-grp ml-auto hidden md:flex">
      <LocaleSwitch alternates={alternates} />
      <ThemeSwitch />
    </div>

    <button
      type="button"
      popovertarget="mobile-nav"
      class="o-grp o-tool ml-auto md:hidden"
    >
      <svg viewBox="0 0 20 20" aria-hidden="true" class="size-5">
        <path d="M2 6 H 18 M 2 10 H 18 M 2 14 H 18" stroke="currentColor"
        ></path>
      </svg>
      <span class="sr-only">{m.nav_menu({}, options)}</span>
    </button>
  </div>

  <!-- Phone navigation: native popover (light dismiss, Esc, focus handling), no JavaScript. -->
  <nav
    id="mobile-nav"
    popover
    aria-label={m.nav_primary({}, options)}
    class="o-menu md:hidden"
  >
    <div class="o-wrap flex items-center justify-between">
      <span class="o-label">{m.nav_menu({}, options)}</span>
      <button
        type="button"
        popovertarget="mobile-nav"
        popovertargetaction="hide"
        class="o-btn o-btn-icon o-btn-sm"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5 5 L 15 15 M 15 5 L 5 15" stroke="currentColor"></path>
        </svg>
        <span class="sr-only">{m.nav_menu({}, options)}</span>
      </button>
    </div>
    <ul class="o-wrap mt-8 grid gap-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.localized}
              aria-current={link.current ? "page" : undefined}
              class="o-btn w-full justify-start"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="o-wrap mt-8 flex flex-wrap items-center gap-4">
      <div class="o-grp"><LocaleSwitch alternates={alternates} /></div>
      <div class="o-grp min-h-11"><ThemeSwitch /></div>
    </div>
  </nav>
</header>
