---
/**
 * The techno orchid mark (from `design/incoming/logo-mark.svg`), themed through the `--orchid` /
 * `--aurora` tokens. Decorative: the accessible name lives on the surrounding link.
 *
 * `weight` is the stroke width in viewBox units (1000): the master's 19 suits large renders;
 * small renders need heavier strokes to stay crisp. Inside a `.group`, hovering redraws the
 * circuit traces.
 */
interface Props {
  class?: string;
  weight?: number;
}

const { class: className, weight = 19 } = Astro.props;
const gradient = "orkide-mark-gradient";
const petals =
  "M 500 390 C 405 340 413 238 500 120 C 587 238 595 340 500 390 M 449 430 C 390 325 232 278 135 410 C 133 514 323 554 444 485 M 551 430 C 610 325 768 278 865 410 C 867 514 677 554 556 485 M 448 528 C 350 511 248 614 246 743 C 375 753 456 657 467 580 M 552 528 C 650 511 752 614 754 743 C 625 753 544 657 533 580 M 474 583 C 453 637 422 681 438 719 C 451 751 478 755 480 800 Q 500 848 520 800 C 522 755 549 751 562 719 C 578 681 547 637 526 583";
const traces =
  "M 500 377 V 237 M 437 459 H 346 Q 333 459 324 450 L 274 400 M 563 459 H 654 Q 667 459 676 450 L 726 400 M 450 550 L 363 637 M 550 550 L 637 637 M 500 588 V 739";
const nodes = [
  [500, 225],
  [269, 395],
  [731, 395],
  [355, 645],
  [645, 645],
  [500, 751],
] as const;
---

<svg
  class={className}
  viewBox="0 0 1000 1000"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient
      id={gradient}
      x1="0"
      y1="120"
      x2="0"
      y2="850"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="var(--orchid)"></stop>
      <stop offset="1" stop-color="var(--aurora)"></stop>
    </linearGradient>
  </defs>
  <g
    fill="none"
    stroke={`url(#${gradient})`}
    stroke-width={weight}
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d={petals}></path>
    <path class="trace" d={traces} pathLength="1"></path>
    {
      nodes.map(([cx, cy]) => (
        <circle cx={cx} cy={cy} r={Math.max(15, weight * 0.8)} />
      ))
    }
  </g>
  <circle
    class="heart"
    cx="500"
    cy="500"
    r={Math.max(29, weight * 1.4)}
    fill={`url(#${gradient})`}></circle>
</svg>

<style>
  .trace {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .heart {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 600ms var(--ease-out-expo);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.group:hover) .trace {
      animation: orkide-trace 1.1s var(--ease-out-expo);
    }

    :global(.group:hover) .heart {
      transform: scale(1.35);
    }
  }

  @keyframes orkide-trace {
    from {
      stroke-dashoffset: 1;
    }
  }
</style>
