---
/** Orchid glyph: five petals around a lip, drawn in the brand gradient. Decorative. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const id = "orkide-logo-gradient";
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--orchid)"></stop>
      <stop offset="1" stop-color="var(--aurora)"></stop>
    </linearGradient>
  </defs>
  <g fill={`url(#${id})`}>
    <ellipse cx="16" cy="8.5" rx="3.6" ry="7" opacity="0.9"></ellipse>
    <ellipse
      cx="16"
      cy="8.5"
      rx="3.6"
      ry="7"
      opacity="0.75"
      transform="rotate(72 16 16)"></ellipse>
    <ellipse
      cx="16"
      cy="8.5"
      rx="3.6"
      ry="7"
      opacity="0.75"
      transform="rotate(-72 16 16)"></ellipse>
    <ellipse
      cx="16"
      cy="9.5"
      rx="3"
      ry="6"
      opacity="0.6"
      transform="rotate(144 16 16)"></ellipse>
    <ellipse
      cx="16"
      cy="9.5"
      rx="3"
      ry="6"
      opacity="0.6"
      transform="rotate(-144 16 16)"></ellipse>
  </g>
  <circle cx="16" cy="16" r="2.6" fill="var(--background)"></circle>
  <circle cx="16" cy="16" r="1.4" fill="var(--orchid)"></circle>
</svg>
