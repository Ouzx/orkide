---
interface Props {
  message: string;
}
const { message } = Astro.props;
---

<!-- An empty listing: the display shows a blank reading. -->
<div class="o-display my-6 max-w-xl">
  <p class="o-readout relative m-0 border-0 pt-0">
    <span aria-hidden="true">▶ ----</span>
    <span class="o-readout-sel whitespace-normal">{message}</span>
  </p>
</div>
