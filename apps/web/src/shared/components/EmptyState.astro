---
import { m } from "@orkide/i18n/messages";

interface Props {
  message: string;
}
const { message } = Astro.props;
const { locale } = Astro.locals;
---

<!-- An empty listing: a blank sheet, stamped as not issued yet. -->
<div class="o-empty">
  <span class="o-stamp o-stamp-static" aria-hidden="true">
    <b>{m.sheet_not_issued({}, { locale })}</b>
  </span>
  <p>{message}</p>
</div>
